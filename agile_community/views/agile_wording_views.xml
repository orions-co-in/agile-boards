<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Agile projects call tasks issues (NU-16). -->
    <record id="agile_quick_create_wording" model="ir.ui.view">
        <field name="name">project.task.quick.create.agile.wording</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.quick_create_task_form"/>
        <field name="arch" type="xml">
            <field name="display_name" position="attributes">
                <attribute name="string">Issue title</attribute>
                <attribute name="placeholder">e.g. Add a login screen</attribute>
            </field>
        </field>
    </record>

    <record id="project.mt_task_new" model="mail.message.subtype">
        <field name="name">Issue Created</field>
        <field name="description">Issue Created</field>
    </record>
</odoo>
