<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="agile_task_type_search" model="ir.ui.view">
        <field name="name">agile.community.task.type.search</field>
        <field name="model">agile_community.task_type</field>
        <field name="arch" type="xml">
            <search string="Issue Types">
                <field name="name"/>
                <field name="project_ids"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Project" name="group_by_project" context="{'group_by': 'project_ids'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="agile_task_type_list" model="ir.ui.view">
        <field name="name">agile.community.task.type.list</field>
        <field name="model">agile_community.task_type</field>
        <field name="arch" type="xml">
            <list string="Issue Types" default_order="sequence, name" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_epic" optional="show" width="80px"/>
                <field name="color" widget="color_picker" optional="show" width="80px"/>
                <field name="project_ids" widget="many2many_tags" options="{'no_create': True}" optional="show" width="140px"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="show" width="80px"/>
            </list>
        </field>
    </record>

    <record id="agile_task_type_form" model="ir.ui.view">
        <field name="name">agile.community.task.type.form</field>
        <field name="model">agile_community.task_type</field>
        <field name="arch" type="xml">
            <form string="Issue Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Defect"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="is_epic"/>
                            <field name="color" widget="color_picker"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="project_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="All Agile projects"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Explain when teams should use this issue type."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="agile_task_type_action" model="ir.actions.act_window">
        <field name="name">Issue Types</field>
        <field name="res_model">agile_community.task_type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="agile_task_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an issue type</p>
            <p>Shared issue types are administered from Project Configuration by an Odoo Administrator. Agile Managers can create project-specific types from project settings. Archive a referenced type instead of deleting it.</p>
        </field>
    </record>

    <menuitem id="agile_task_type_menu"
              name="Issue Types"
              parent="project.menu_project_config"
              action="agile_task_type_action"
              groups="base.group_system"
              sequence="25"/>
</odoo>
