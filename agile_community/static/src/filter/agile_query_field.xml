<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="agile_community.AgileQueryField">
        <div class="o_agile_query">
            <div class="o_agile_query_mode btn-group btn-group-sm" role="group" aria-label="Editor">
                <button type="button" class="btn btn-outline-secondary" t-att-class="{ active: this.state.mode === 'basic' }"
                        t-att-aria-pressed="this.state.mode === 'basic' ? 'true' : 'false'" t-att-disabled="!this.state.basicOk"
                        t-on-click="() => this.setMode('basic')">Basic</button>
                <button type="button" class="btn btn-outline-secondary" t-att-class="{ active: this.state.mode === 'advanced' }"
                        t-att-aria-pressed="this.state.mode === 'advanced' ? 'true' : 'false'"
                        t-on-click="() => this.setMode('advanced')">Advanced</button>
            </div>
            <div t-if="!this.state.basicOk" class="o_agile_query_note text-muted">
                Basic cannot show this query because it uses <t t-out="this.blockerText or 'something Basic does not offer'"/>. Edit it in the bar.
            </div>
            <div t-if="this.state.mode === 'basic' and this.state.basicOk" class="o_agile_query_rows">
                <div t-foreach="this.state.rows" t-as="row" t-key="row_index" class="o_agile_query_row">
                    <select class="form-select" aria-label="Field" t-on-change="(ev) => this.onRowField(row, ev)"
                            t-att-disabled="this.props.readonly">
                        <option t-foreach="this.state.options" t-as="option" t-key="option.field" t-att-value="option.field"
                                t-att-selected="option.field === row.field" t-out="option.label"/>
                    </select>
                    <select class="form-select" aria-label="Condition" t-on-change="(ev) => this.onRowOp(row, ev)"
                            t-att-disabled="this.props.readonly">
                        <option t-foreach="this.optionFor(row.field)?.ops or []" t-as="op" t-key="op.op" t-att-value="op.op"
                                t-att-selected="op.op === row.op" t-out="op.label"/>
                    </select>
                    <t t-if="!row.op.startsWith('IS ')">
                        <select t-if="this.optionFor(row.field)?.values" class="form-select" aria-label="Value"
                                t-on-change="(ev) => this.onRowValue(row, ev)" t-att-disabled="this.props.readonly">
                            <option t-foreach="this.valuesFor(row)" t-as="value" t-key="value" t-att-value="value"
                                    t-att-selected="value === row.value" t-out="value"/>
                        </select>
                        <input t-else="" type="text" class="form-control" aria-label="Value" t-att-value="row.value"
                               placeholder="2026-10-27, today, -7d" t-att-readonly="this.props.readonly or undefined"
                               t-on-change="(ev) => this.onRowValue(row, ev)"/>
                    </t>
                    <button t-if="!this.props.readonly" type="button" class="btn btn-link o_agile_query_remove"
                            t-att-aria-label="'Remove condition ' + (row_index + 1)" t-on-click="() => this.removeRow(row_index)">×</button>
                </div>
                <div t-if="!this.props.readonly" class="o_agile_query_add">
                    <span class="text-muted">Add a condition:</span>
                    <button t-foreach="this.state.options" t-as="option" t-key="option.field" type="button"
                            class="btn btn-sm btn-outline-secondary o_agile_query_chip" t-on-click="() => this.addRow(option)"
                            t-out="option.label"/>
                </div>
                <div t-if="this.state.sort" class="o_agile_query_sort text-muted">
                    Sorted: <t t-out="this.state.sort.replace('ORDER BY ', '')"/>
                    <button t-if="!this.props.readonly" type="button" class="btn btn-link btn-sm o_agile_query_clear_sort" t-on-click="this.clearSort">Remove sort</button>
                </div>
                <label t-if="this.state.rows.length > 1" class="o_agile_query_any">
                    <input type="checkbox" t-att-checked="this.state.matchAny" t-att-disabled="this.props.readonly"
                           t-on-change="this.onMatchAny"/> Match any of these
                </label>
            </div>
            <div class="o_agile_query_bar" t-att-class="{ 'o_agile_query_bar_hidden': this.state.mode === 'basic' and this.state.basicOk }">
                <input type="text" class="o_agile_query_input form-control form-control-lg"
                       t-ref="this.input" t-att-value="this.state.text" t-att-readonly="this.props.readonly or undefined"
                       role="combobox" aria-autocomplete="list" aria-label="Query"
                       t-att-aria-expanded="this.state.open ? 'true' : 'false'"
                       t-att-aria-controls="this.listId" aria-describedby="agile_query_status"
                       t-att-aria-invalid="this.state.error ? 'true' : 'false'"
                       placeholder='status = "In Progress" AND assignee = me'
                       autocomplete="off" spellcheck="false"
                       t-on-input="this.onInput" t-on-keydown="this.onKeydown" t-on-click="this.onClick" t-on-blur="this.onBlur"/>
                <ul t-if="this.state.open and this.state.suggest.items.length" class="o_agile_query_list" role="listbox" t-att-id="this.listId">
                    <li t-foreach="this.state.suggest.items" t-as="item" t-key="item_index" role="option"
                        t-att-aria-selected="item_index === this.state.index ? 'true' : 'false'"
                        t-att-class="{ 'active': item_index === this.state.index }"
                        t-on-mousedown.prevent="() => this.accept(item)">
                        <span class="o_agile_query_word" t-out="item.label"/>
                        <span t-if="item.hint" class="o_agile_query_hint" t-out="item.hint"/>
                    </li>
                </ul>
            </div>
            <div id="agile_query_status" class="o_agile_query_status" aria-live="polite"
                 t-att-class="{ 'o_agile_query_error': this.state.error }">
                <span class="o_agile_query_count" t-out="this.statusText"/>
                <span t-if="this.state.ok and this.state.words" class="o_agile_query_words" t-out="this.state.words"/>
                <button t-if="!this.state.text and !this.props.readonly" type="button" class="btn btn-link p-0 o_agile_query_example"
                        t-on-click="this.onExample">Try an example</button>
            </div>
        </div>
    </t>
</templates>
