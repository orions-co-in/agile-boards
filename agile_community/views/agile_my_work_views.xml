<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_search_agile_my_work" model="ir.ui.view">
        <field name="name">project.task.search.agile.my.work</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_task_search_agile"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='agile_blocked']" position="after">
                <separator/>
                <filter string="Assigned to me" name="agile_my_assigned" domain="[('user_ids', 'in', uid)]"/>
                <filter string="Review requested" name="agile_my_review" domain="[('stage_id.agile_status', '=', 'review')]" groups="agile_community.group_agile_reviewer,project.group_project_manager"/>
                <filter string="Due soon" name="agile_my_due_soon" domain="[('date_deadline', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0, 0, 0)).to_utc().strftime('%Y-%m-%d %H:%M:%S')), ('date_deadline', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=8), datetime.time(0, 0, 0)).to_utc().strftime('%Y-%m-%d %H:%M:%S'))]"/>
            </xpath>
        </field>
    </record>

    <record id="project_task_list_agile_my_work" model="ir.ui.view">
        <field name="name">project.task.list.agile.my.work</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_task_list_agile"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="sample">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_agile_my_work_assigned" model="ir.actions.act_window">
        <field name="name">Assigned to me</field>
        <field name="res_model">project.task</field>
        <field name="path">agile-my-work</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="project_task_search_agile_my_work"/>
        <field name="domain">[
            ('project_id.agile_enabled', '=', True),
            ('agile_issue', '=', True),
            ('user_ids', 'in', uid),
            ('stage_id.agile_status', 'not in', ['done', 'canceled']),
        ]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No open Agile issues are assigned to you.</p>
            <p>New assignments will appear here automatically.</p>
        </field>
    </record>

    <record id="action_agile_my_work_review" model="ir.actions.act_window">
        <field name="name">Review requested</field>
        <field name="res_model">project.task</field>
        <field name="path">agile-review-requested</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="project_task_search_agile_my_work"/>
        <field name="domain">[
            ('project_id.agile_enabled', '=', True),
            ('agile_issue', '=', True),
            ('stage_id.agile_status', '=', 'review'),
        ]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">There are no Agile issues waiting for review.</p>
            <p>Issues sent to Review in projects you can access will appear here.</p>
        </field>
    </record>

    <record id="action_agile_my_work_blocked" model="ir.actions.act_window">
        <field name="name">Blocked</field>
        <field name="res_model">project.task</field>
        <field name="path">agile-my-blocked</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="project_task_search_agile_my_work"/>
        <field name="domain">[
            ('project_id.agile_enabled', '=', True),
            ('agile_issue', '=', True),
            ('user_ids', 'in', uid),
            ('agile_is_blocked', '=', True),
            ('stage_id.agile_status', 'not in', ['done', 'canceled']),
        ]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">None of your open Agile issues are blocked.</p>
            <p>Issues assigned to you will appear here while blocked.</p>
        </field>
    </record>

    <record id="action_agile_my_work_due_soon" model="ir.actions.act_window">
        <field name="name">Due soon</field>
        <field name="res_model">project.task</field>
        <field name="path">agile-my-due-soon</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="project_task_search_agile_my_work"/>
        <field name="domain">[
            ('project_id.agile_enabled', '=', True),
            ('agile_issue', '=', True),
            ('user_ids', 'in', uid),
            ('date_deadline', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0, 0, 0)).to_utc().strftime('%Y-%m-%d %H:%M:%S')),
            ('date_deadline', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=8), datetime.time(0, 0, 0)).to_utc().strftime('%Y-%m-%d %H:%M:%S')),
            ('stage_id.agile_status', 'not in', ['done', 'canceled']),
        ]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">You have no Agile issues due in the next seven days.</p>
            <p>This list uses your local date and excludes completed or canceled issues.</p>
        </field>
    </record>

    <record id="action_agile_my_work_assigned_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="project_task_list_agile_my_work"/>
        <field name="act_window_id" ref="action_agile_my_work_assigned"/>
    </record>
    <record id="action_agile_my_work_review_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="project_task_list_agile_my_work"/>
        <field name="act_window_id" ref="action_agile_my_work_review"/>
    </record>
    <record id="action_agile_my_work_blocked_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="project_task_list_agile_my_work"/>
        <field name="act_window_id" ref="action_agile_my_work_blocked"/>
    </record>
    <record id="action_agile_my_work_due_soon_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="project_task_list_agile_my_work"/>
        <field name="act_window_id" ref="action_agile_my_work_due_soon"/>
    </record>
    <record id="action_agile_my_work_assigned_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="project_task_kanban_agile_backlog_order"/>
        <field name="act_window_id" ref="action_agile_my_work_assigned"/>
    </record>
    <record id="action_agile_my_work_review_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="project_task_kanban_agile_backlog_order"/>
        <field name="act_window_id" ref="action_agile_my_work_review"/>
    </record>
    <record id="action_agile_my_work_blocked_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="project_task_kanban_agile_backlog_order"/>
        <field name="act_window_id" ref="action_agile_my_work_blocked"/>
    </record>
    <record id="action_agile_my_work_due_soon_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="project_task_kanban_agile_backlog_order"/>
        <field name="act_window_id" ref="action_agile_my_work_due_soon"/>
    </record>

    <menuitem id="menu_agile_my_work" name="My Work" parent="project.menu_project_management" sequence="0"/>
    <menuitem id="menu_agile_my_work_assigned" name="Assigned" parent="menu_agile_my_work" action="action_agile_my_work_assigned" sequence="1"/>
    <menuitem id="menu_agile_my_work_review" name="Review requested" parent="menu_agile_my_work" action="action_agile_my_work_review" groups="agile_community.group_agile_reviewer,project.group_project_manager" sequence="2"/>
    <menuitem id="menu_agile_my_work_blocked" name="Blocked" parent="menu_agile_my_work" action="action_agile_my_work_blocked" sequence="3"/>
    <menuitem id="menu_agile_my_work_due_soon" name="Due soon" parent="menu_agile_my_work" action="action_agile_my_work_due_soon" sequence="4"/>
</odoo>
