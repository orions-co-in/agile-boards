<odoo>
    <record id="group_agile_reviewer" model="res.groups">
        <field name="name">Agile Reviewer</field>
        <field name="comment">Can return or complete Agile issues in Review.</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_agile_stakeholder" model="res.groups">
        <field name="name">Agile Stakeholder</field>
        <field name="comment">Read-only access to visible Agile projects and issues.</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_agile_admin" model="res.groups">
        <field name="name">Agile Administrator</field>
        <field name="comment">Acts as manager on every Agile project without being on its team. Odoo administrators have the same ceiling.</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <!-- Odoo administrators already pass every Agile check; this also gives them native Project access,
         which a plain Settings administrator would not have. Followers-only projects still need a follow. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_agile_admin'))]"/>
    </record>

        <!-- Odoo 20: the unrestricted release permission of project_version is replaced by the team-only rows in ir.access.csv. -->
    <record id="project_version.project_version" model="ir.access">
        <field name="active" eval="False"/>
    </record>
</odoo>
