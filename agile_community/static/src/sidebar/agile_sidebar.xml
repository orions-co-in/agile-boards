<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="agile_community.SidebarIcon">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path t-att-d="path"/></svg>
    </t>

    <t t-name="agile_community.Sidebar">
        <t t-if="this.state.data">
            <nav class="o_ag_side" aria-label="Project">
                <div class="o_ag_side_project">
                    <span class="o_ag_side_key" t-out="this.state.data.key or this.state.data.name.slice(0, 4)"/>
                    <span class="o_ag_side_name">
                        <b t-out="this.state.data.name"/>
                        <small>
                            <t t-out="this.state.data.method === 'scrum' ? 'Scrum' : 'Kanban'"/>
                            <t t-if="this.state.data.sprint"> · <t t-out="this.state.data.sprint"/></t>
                        </small>
                        <small t-if="this.state.data.access_label" class="o_ag_side_access" t-out="this.state.data.access_label"/>
                    </span>
                </div>
                <t t-foreach="this.groups" t-as="group" t-key="group.name">
                    <div class="o_ag_side_group" t-out="group.name"/>
                    <t t-foreach="group.entries" t-as="entry" t-key="entry.key">
                        <button type="button"
                                class="o_ag_side_item" t-att-aria-current="this.state.entry === entry.key ? 'page' : false"
                                t-att-title="entry.label" t-on-click="() => this.open(entry.key)">
                            <t t-call="agile_community.SidebarIcon" path="entry.icon"/>
                            <span class="o_ag_side_label" t-out="entry.label"/>
                            <t t-set="badge" t-value="this.badgeFor(entry.key)"/>
                            <span t-if="badge" class="o_ag_side_badge" t-att-class="{ 'o_ag_side_badge_danger': badge.danger }" t-att-title="badge.tip" t-att-aria-label="badge.tip + ': ' + badge.text" t-out="badge.text"/>
                        </button>
                        <t t-if="entry.key === 'board'">
                            <button t-foreach="this.state.data.boards || []" t-as="board" t-key="board.id" type="button"
                                    class="o_ag_side_item o_ag_side_board" t-att-title="board.name"
                                    t-att-aria-current="this.state.entry === 'board' and this.state.data.board_id === board.id ? 'page' : false"
                                    t-on-click="() => this.openBoard(board.id)">
                                <span class="o_ag_side_label" t-out="board.name"/>
                            </button>
                        </t>
                    </t>
                </t>
                <button type="button" class="o_ag_side_item o_ag_side_shortcuts" aria-keyshortcuts="?" t-on-click="this.showShortcuts">
                    <t t-call="agile_community.SidebarIcon"
                        path="'M4 7h16v10H4z M7 10h.01M10 10h.01M13 10h.01M16 10h.01M8 14h8'"/>
                    <span class="o_ag_side_label">Shortcuts</span>
                </button>
                <a t-if="this.canInstall" class="o_ag_side_item o_ag_side_install" t-att-href="this.installUrl" target="_blank" rel="noopener">
                    <t t-call="agile_community.SidebarIcon" path="'M12 4v10M8 10l4 4 4-4M5 19h14'"/>
                    <span class="o_ag_side_label">Install app</span>
                </a>
            </nav>
            <nav class="o_ag_bottom" aria-label="Project">
                <button t-foreach="this.bottomEntries" t-as="entry" t-key="entry.key" type="button"
                        t-att-aria-current="this.state.entry === entry.key ? 'page' : false" t-on-click="() => this.open(entry.key)">
                    <t t-call="agile_community.SidebarIcon" path="entry.icon"/>
                    <span t-out="entry.label"/>
                </button>
                <button type="button" aria-haspopup="true" t-att-aria-expanded="this.state.more ? 'true' : 'false'" t-on-click="this.toggleMore">
                    <t t-call="agile_community.SidebarIcon" path="'M5 12h.01M12 12h.01M19 12h.01'"/>
                    <span>More</span>
                </button>
                <div t-if="this.state.more" class="o_ag_bottom_sheet">
                    <button t-foreach="this.moreEntries" t-as="entry" t-key="entry.key" type="button"
                            t-att-aria-current="this.state.entry === entry.key ? 'page' : false" t-on-click="() => this.open(entry.key)">
                        <t t-call="agile_community.SidebarIcon" path="entry.icon"/>
                        <span t-out="entry.label"/>
                    </button>
                    <a t-if="this.canInstall" class="o_ag_install_link" t-att-href="this.installUrl" target="_blank" rel="noopener">
                        <t t-call="agile_community.SidebarIcon" path="'M12 4v10M8 10l4 4 4-4M5 19h14'"/>
                        <span>Install app</span>
                    </a>
                </div>
            </nav>
        </t>
    </t>
</templates>
