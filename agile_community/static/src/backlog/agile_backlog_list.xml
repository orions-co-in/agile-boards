<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="agile_community.BacklogListRenderer" t-inherit="web.ListRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_list_renderer')]/*[1]" position="before">
            <section t-if="planActions.length" class="o_ag_plan_strip d-md-none" aria-label="Sprint planning">
                <div t-foreach="planActions" t-as="item" t-key="item.sprint.id" class="o_ag_plan_strip_row">
                    <span class="o_ag_plan_strip_name"><b t-out="item.sprint.name"/> <span t-out="item.chip.text"/></span>
                    <button type="button" class="btn btn-secondary btn-sm o_ag_plan_strip_action"
                            t-on-click="() => this.runSprintAction(item.sprint, item.chip.action)" t-out="item.chip.label"/>
                </div>
            </section>
            <section t-if="info.data" class="o_ag_filters" aria-label="Filter the backlog">
                <t t-foreach="pickLists"
                   t-as="pick" t-key="pick[0]">
                    <Dropdown menuClass="'o_ag_multi_menu'">
                        <button type="button" t-attf-class="btn btn-secondary btn-sm o_ag_multi {{multiIds(pick[0]).length ? 'o_ag_multi_on' : ''}}"
                                t-att-data-kind="pick[0]" t-out="multiSummary(pick[0], pick[2], pick[3])"/>
                        <t t-set-slot="content">
                            <label t-foreach="pick[3]" t-as="choice" t-key="choice.id" class="o_ag_multi_row">
                                <input type="checkbox" t-att-checked="multiIds(pick[0]).includes(choice.id)"
                                       t-on-change="() => this.toggleMulti(pick[0], pick[1], pick[2], pick[3], choice.id)"/>
                                <span t-out="choice.label"/>
                                <span t-if="choice.count !== undefined" class="o_ag_multi_count text-muted" t-out="choice.count"/>
                            </label>
                            <button t-if="multiIds(pick[0]).length" type="button" class="btn btn-link btn-sm o_ag_multi_clear"
                                    t-on-click="() => this.clearMulti(pick[0])">Clear</button>
                        </t>
                    </Dropdown>
                </t>
            </section>
            <section t-if="epics.data" class="o_ag_epics" aria-label="Epics">
                <button type="button" class="btn btn-link o_ag_epics_toggle" t-att-aria-expanded="epics.open ? 'true' : 'false'"
                        t-on-click="toggleEpics">
                    <i t-attf-class="fa fa-fw {{epics.open ? 'fa-caret-down' : 'fa-caret-right'}}" aria-hidden="true"/>
                    Epics (<t t-out="epicList.length"/>)
                </button>
                <t t-if="epics.open">
                    <p t-if="!epicList.length" class="o_ag_epics_empty text-muted mb-0">
                        No epics yet. Create an epic issue to group related work and follow its progress here.
                    </p>
                    <ul t-else="" class="o_ag_epic_list list-unstyled">
                        <li t-foreach="epicList" t-as="epic" t-key="epic.id">
                            <t t-set="progress" t-value="epicProgress(epic)"/>
                            <button type="button" t-attf-class="o_ag_epic {{activeEpicId === epic.id ? 'o_ag_epic_active' : ''}}"
                                    t-att-aria-pressed="activeEpicId === epic.id ? 'true' : 'false'"
                                    t-att-data-epic-id="epic.id"
                                    t-on-click="() => this.selectEpic(epic)">
                                <span class="o_ag_epic_name">
                                    <span class="o_ag_epic_key" t-if="epic.issue_key" t-out="epic.issue_key"/>
                                    <span t-out="epic.name"/>
                                </span>
                                <span class="o_ag_epic_bar" role="img"
                                      t-att-aria-label="progress.issues + (progress.points ? ', ' + progress.points : '')">
                                    <i t-attf-style="width: {{progress.percent}}%"/>
                                </span>
                                <span class="o_ag_epic_text">
                                    <t t-out="progress.issues"/><t t-if="progress.points">, <t t-out="progress.points"/></t>
                                </span>
                            </button>
                            <button type="button" class="btn btn-link btn-sm o_ag_epic_report"
                                    t-att-aria-label="'Open the burndown of ' + epic.name"
                                    t-on-click="() => this.openReport('epic', epic.id)">Burndown</button>
                        </li>
                    </ul>
                </t>
            </section>
        </xpath>
        <xpath expr="//div[hasclass('o_list_renderer')]" position="inside">
            <section t-if="emptyBacklog" class="o_ag_empty_backlog o_view_nocontent_inline text-center py-4" aria-label="Empty backlog">
                <p class="h5 mb-1">No issues yet</p>
                <p class="text-muted mb-3">The Backlog is empty. <t t-if="emptyGroup">Add the first issue below.</t></p>
                <div t-if="emptyGroup" class="o_ag_quick_row text-start">
                    <AgileQuickCreate t-key="quickGroupKey(emptyGroup)"
                                      groupKey="quickGroupKey(emptyGroup)"
                                      label="groupName(emptyGroup)"
                                      types="info.data.task_types"
                                      members="info.data.members"
                                      typeId="quickTypeId()"
                                      onTypeChange.bind="setQuickType"
                                      onCreate="(vals) => this.createIssue(emptyGroup, vals)"/>
                </div>
            </section>
            <div class="visually-hidden o_ag_live" role="status" aria-live="polite" t-out="announcer.text"/>
            <AgileBulkBar t-if="bulkProjectId" t-key="bulkProjectId" projectId="bulkProjectId"
                          ids="selectedIds" onDone.bind="onBulkDone" onClear.bind="clearSelection"/>
        </xpath>
    </t>

    <t t-name="agile_community.BacklogRows" t-inherit="web.ListRenderer.Rows" t-inherit-mode="primary">
        <xpath expr="//t[@t-if='!group.isFolded']" position="inside">
            <tr t-if="quickAllowed(group)" class="o_ag_quick_row">
                <td t-att-colspan="nbCols">
                    <AgileQuickCreate t-key="quickGroupKey(group)"
                                      groupKey="quickGroupKey(group)"
                                      label="groupName(group)"
                                      types="info.data.task_types"
                                      members="info.data.members"
                                      typeId="quickTypeId()"
                                      onTypeChange.bind="setQuickType"
                                      onCreate="(vals) => this.createIssue(group, vals)"/>
                </td>
            </tr>
        </xpath>
    </t>

    <t t-name="agile_community.BacklogButtons">
        <button t-if="isScrum" type="button" class="btn btn-secondary o_ag_toggle_completed"
                t-att-aria-pressed="completedHidden ? 'false' : 'true'"
                t-on-click="toggleCompleted">
            <t t-if="completedHidden">Show completed sprints</t>
            <t t-else="">Hide completed sprints</t>
        </button>
    </t>

    <t t-name="agile_community.BacklogGroupRow" t-inherit="web.ListRenderer.GroupRow" t-inherit-mode="primary">
        <xpath expr="//th/div" position="replace">
            <div class="o_ag_group d-flex align-items-center flex-wrap gap-2">
                <span t-attf-class="o_group_caret fa fa-fw {{group.isFolded ? 'fa-caret-right' : 'fa-caret-down' }}"
                      t-attf-style="--o-list-group-level: {{getGroupLevel(group)}}"/>
                <t t-if="!isSprintGroup(group)">
                    <span t-out="group.displayName"/> (<span t-out="group.count"/>)
                </t>
                <t t-elif="isBacklogGroup(group)">
                    <input t-if="canEdit and group.list.records.length" type="checkbox" class="o_ag_group_select" t-att-checked="groupSelected(group)"
                           aria-label="Select all issues in the Backlog" t-on-click.stop="" t-on-change="(ev) => this.toggleGroupSelection(group, ev)"/>
                    <b class="o_ag_group_name">Backlog</b>
                    <span class="o_ag_group_meta" t-out="backlogText()"/>
                </t>
                <t t-else="">
                    <t t-set="sprint" t-value="sprintFor(group)"/>
                    <input t-if="canEdit and group.list.records.length" type="checkbox" class="o_ag_group_select" t-att-checked="groupSelected(group)"
                           t-att-aria-label="'Select all issues in ' + groupName(group)" t-on-click.stop="" t-on-change="(ev) => this.toggleGroupSelection(group, ev)"/>
                    <b class="o_ag_group_name" t-out="groupName(group)"/>
                    <t t-if="sprint">
                        <span t-attf-class="o_ag_sprint_state o_ag_sprint_{{sprint.state}}" t-out="stateLabel(sprint)"/>
                        <span class="o_ag_group_meta" t-out="dates(sprint)"/>
                        <span t-if="sprint.goal and sprint.state !== 'done'" class="o_ag_group_goal text-truncate"
                              t-att-title="sprint.goal" t-out="sprint.goal"/>
                        <span class="o_ag_group_spacer"/>
                        <span t-attf-class="o_ag_group_points {{sprint.over_capacity ? 'o_ag_over' : ''}}"
                              t-out="pointsText(sprint)"/>
                        <span t-if="sprint.state !== 'done'" role="img"
                              t-attf-class="o_ag_ribbon {{sprint.over_capacity ? 'o_ag_over' : ''}}"
                              t-att-aria-label="ribbonLabel(sprint)">
                            <i t-foreach="ribbonSegments(sprint)" t-as="segment" t-key="segment.status"
                               t-attf-class="o_ag_s_{{segment.status}}"
                               t-attf-style="width: {{segment.width}}%" t-att-title="segment.label"/>
                        </span>
                        <span t-if="sprint.unestimated_count and sprint.state !== 'done'" class="o_ag_group_meta"
                              t-out="unestimatedText(sprint.unestimated_count)"/>
                        <t t-set="chip" t-value="planChip(sprint)"/>
                        <t t-if="chip">
                            <span t-attf-class="o_ag_plan_chip {{chip.tone ? 'o_ag_plan_' + chip.tone : ''}}"
                                  role="status" t-out="chip.text"/>
                            <button t-if="sprint.can_manage" type="button" class="btn btn-secondary btn-sm o_ag_plan_action"
                                    t-on-click.stop="() => this.runSprintAction(sprint, chip.action)" t-out="chip.label"/>
                            <button t-if="sprint.can_manage and chip.startBlocked" type="button" disabled="1"
                                    class="btn btn-primary btn-sm"
                                    title="Update the plan with a reason before starting">Start sprint</button>
                        </t>
                        <button t-if="sprint.state === 'in_progress' and sprint.can_manage" type="button"
                                class="btn btn-primary btn-sm o_ag_complete_sprint"
                                t-on-click.stop="() => this.completeSprint(sprint)">Complete sprint</button>
                        <button t-if="sprint.state === 'done' or sprint.state === 'in_progress'" type="button"
                                class="btn btn-link btn-sm o_ag_sprint_report"
                                t-on-click.stop="() => this.openReport('sprint', sprint.id)">Sprint report</button>
                        <span t-if="sprint.reopen_count and sprint.state === 'in_progress'" class="o_ag_group_meta o_ag_reopened" role="status">
                            Reopened<t t-if="sprint.reopen_count > 1"> <t t-out="sprint.reopen_count"/> times</t>
                        </span>
                        <button t-if="sprint.state === 'done' and sprint.can_manage" type="button" class="btn btn-link btn-sm o_ag_reopen_sprint"
                                t-att-disabled="!sprint.can_reopen" t-att-title="sprint.can_reopen ? null : 'Another sprint is active or a later sprint has started.'"
                                t-on-click.stop="() => this.reopenSprint(sprint)">Reopen sprint</button>
                        <button t-if="sprint.state === 'done'" type="button" class="btn btn-link btn-sm"
                                t-on-click.stop="() => this.openSprint(sprint)">Open sprint</button>
                    </t>
                    <t t-elif="info.error">
                        <span class="o_ag_group_meta">Sprint details unavailable</span>
                        <button type="button" class="btn btn-link btn-sm" t-on-click.stop="retryInfo">Retry</button>
                    </t>
                </t>
                <div t-if="showGroupPager(group)" t-on-click.stop="" class="ms-auto">
                    <Pager t-props="getGroupPagerProps(group)"/>
                </div>
            </div>
        </xpath>
    </t>
</templates>
