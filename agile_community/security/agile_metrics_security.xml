<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="agile_metric_snapshot_project_user_rule" model="ir.rule">
            <field name="name">Agile metric snapshots: visible projects</field>
            <field name="model_id" ref="model_agile_metric_snapshot"/>
            <field name="domain_force">[
                (1, '=', 1) if user.has_group('agile_community.group_agile_admin') or user.has_group('base.group_system') else ('project_id.agile_member_ids', 'any', [('user_id', '=', user.id)]),
                '|',
                    ('project_id.privacy_visibility', 'in', ['employees', 'portal']),
                    ('project_id.message_partner_ids', 'in', [user.partner_id.id])
            ]</field>
            <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
        </record>
        <record id="agile_metric_snapshot_company_rule" model="ir.rule">
            <field name="name">Agile metric snapshots: allowed companies</field>
            <field name="model_id" ref="model_agile_metric_snapshot"/>
            <field name="domain_force">[('project_id.company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="agile_metric_snapshot_manager_rule" model="ir.rule">
            <field name="name">Agile metric snapshots: project managers</field>
            <field name="model_id" ref="model_agile_metric_snapshot"/>
            <field name="domain_force">[(1, '=', 1) if user.has_group('agile_community.group_agile_admin') or user.has_group('base.group_system') else ('project_id.agile_member_ids', 'any', [('user_id', '=', user.id), ('role', '=', 'manager')])]</field>
            <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
        </record>
        <record id="agile_metric_line_project_user_rule" model="ir.rule">
            <field name="name">Agile metric issues: same task visibility as Project</field>
            <field name="model_id" ref="model_agile_metric_snapshot_line"/>
