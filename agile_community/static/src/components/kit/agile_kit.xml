<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="agile_community.Lozenge">
        <span t-attf-class="o_ag_lozenge o_ag_s_{{this.category}}">
            <i class="oi oi-fw" t-att-data-icon="this.icon" aria-hidden="true"/>
            <span t-out="this.props.label"/>
        </span>
    </t>

    <t t-name="agile_community.Avatar">
        <span class="o_ag_avatar" role="img" t-att-aria-label="this.label" t-att-title="this.label">
            <t t-out="this.initials"/>
        </span>
    </t>

    <t t-name="agile_community.Chip">
        <button t-if="this.props.onClick" type="button"
                t-attf-class="o_ag_chip o_ag_chip_button {{this.props.active ? 'o_ag_chip_active' : ''}}"
                t-att-aria-pressed="this.props.active ? 'true' : 'false'"
                t-on-click="this.props.onClick">
            <t t-out="this.props.label"/>
        </button>
        <span t-else="" t-attf-class="o_ag_chip {{this.props.active ? 'o_ag_chip_active' : ''}}">
            <t t-out="this.props.label"/>
        </span>
    </t>

    <t t-name="agile_community.TypeDot">
        <span t-attf-class="o_ag_type_dot o_ag_t_{{this.type}}" role="img"
              t-att-aria-label="this.props.label or this.type" t-att-title="this.props.label or this.type"/>
    </t>
</templates>
