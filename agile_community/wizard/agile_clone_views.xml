<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="agile_clone_wizard_form" model="ir.ui.view">
        <field name="name">agile.community.clone.wizard.form</field>
        <field name="model">agile_community.clone_wizard</field>
        <field name="arch" type="xml">
            <form string="Clone issue">
                <p class="text-muted">Copies the title, description, type, points, labels and custom fields. The clone goes to the Backlog and links back to this issue.</p>
                <field name="sprint_can_join" invisible="1"/>
                <field name="has_sprint" invisible="1"/>
                <field name="task_id" invisible="1"/>
                <group>
                    <field name="name"/>
                </group>
                <div class="o_agile_clone_option">
                    <div class="d-flex align-items-center gap-2"><field name="copy_subtasks"/><label for="copy_subtasks"/></div>
                    <div class="text-muted small"><field name="subtask_note" nolabel="1"/></div>
                </div>
                <div class="o_agile_clone_option">
                    <div class="d-flex align-items-center gap-2"><field name="copy_attachments"/><label for="copy_attachments"/></div>
                    <div class="text-muted small"><field name="attachment_note" nolabel="1"/></div>
                </div>
                <div class="o_agile_clone_option" invisible="not has_sprint">
                    <div class="d-flex align-items-center gap-2"><field name="same_sprint" readonly="not sprint_can_join"/><label for="same_sprint"/></div>
                    <div class="text-muted small"><field name="sprint_note" nolabel="1"/></div>
                </div>
                <p class="text-muted mt-2">Not copied: the key, status history, time logged and comments.</p>
                <footer>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="x"/>
                    <button name="action_clone" type="object" string="Clone issue" class="btn-primary" data-hotkey="q"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
