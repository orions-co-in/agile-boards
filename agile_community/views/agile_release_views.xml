<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_version_form_agile" model="ir.ui.view">
        <field name="name">project.version.form.agile</field>
        <field name="model">project.version</field>
        <field name="inherit_id" ref="agile_version.project_version_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <header invisible="not is_agile_release">
                    <button name="action_agile_open_release_confirm" type="object" string="Mark as Released" class="oe_highlight" invisible="state != 'planned' or not can_manage_agile_release" groups="project.group_project_user"/>
                    <button name="action_open_correction" type="object" string="Correct Released Record" invisible="state != 'released' or not can_manage_agile_release" groups="project.group_project_user"/>
                    <button name="action_open_release_notes" type="object" string="Release notes" groups="project.group_project_user"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,released" readonly="1"/>
                </header>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="is_agile_release" invisible="1"/>
                <field name="can_manage_agile_release" invisible="1" groups="project.group_project_user"/>
                <field name="active" invisible="1"/>
                <div class="oe_button_box" name="button_box" invisible="not is_agile_release">
                    <button name="action_view_release_issues" type="object" class="oe_stat_button" icon="format_list_bulleted">
                        <field name="issue_count" widget="statinfo" string="Issues"/>
                    </button>
                    <button name="action_view_release_blockers" type="object" class="oe_stat_button" icon="warning" invisible="not open_issue_count">
                        <field name="open_issue_count" widget="statinfo" string="Open"/>
                    </button>
                    <button name="action_view_affected_issues" type="object" class="oe_stat_button" icon="bug_report" invisible="not affected_issue_count">
                        <field name="affected_issue_count" widget="statinfo" string="Found here"/>
                    </button>
                    <button name="action_open_release_burndown" type="object" class="oe_stat_button" icon="show_chart" string="Burndown" groups="project.group_project_user"/>
                </div>
                <group invisible="not is_agile_release">
                    <group string="Release planning" class="o_agile_label_col">
                        <field name="release_date" readonly="state == 'released'"/>
                        <field name="milestone_id" domain="[('project_id', '=', project_id)]" readonly="state == 'released'" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="released_by_id" invisible="state != 'released'"/>
                        <field name="released_at" invisible="state != 'released'"/>
                    </group>
                    <group string="Readiness" class="o_agile_label_col">
                        <field name="issue_count" readonly="1"/>
                        <field name="done_issue_count" readonly="1"/>
                        <field name="open_issue_count" readonly="1" decoration-warning="open_issue_count &gt; 0"/>
                        <field name="canceled_issue_count" readonly="1"/>
                        <field name="is_ready" widget="boolean" readonly="1" string="Ready to release" help="Ready means the release includes at least one non-Epic issue and every included issue is Done or Canceled. Open issues are available from the Open button above."/>
                    </group>
                </group>
                <field name="description" invisible="not is_agile_release" readonly="state == 'released'" placeholder="What is included in this release?"/>
                <!-- On a phone the header button sits in the three-dot menu; this one stays in plain sight. -->
                <div class="d-md-none mb-3" invisible="not is_agile_release">
                    <button name="action_open_release_notes" type="object" string="Release notes" class="btn btn-secondary" groups="project.group_project_user"/>
                </div>
                <notebook invisible="not is_agile_release">
                    <page string="Included issues">
                        <field name="agile_issue_ids" readonly="1" nolabel="1">
                            <list create="0" edit="0" delete="0" open_form_view="1">
                                <field name="issue_key" readonly="1"/>
                                <field name="name"/>
                                <field name="agile_task_type_id"/>
                                <field name="stage_id"/>
                                <field name="user_ids" widget="many2many_avatar_user" optional="hide"/>
                            </list>
                        </field>
                    </page>
                    <page string="History">
                        <field name="audit_ids" readonly="1" nolabel="1">
                            <list create="0" edit="0" delete="0">
                                <field name="event_date"/>
                                <field name="event_type"/>
                                <field name="actor_id"/>
                                <field name="issue_id" optional="hide"/>
                                <field name="reason" optional="show"/>
                                <field name="previous_values" optional="hide"/>
                                <field name="new_values" optional="hide"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="project_version_tree_agile" model="ir.ui.view">
        <field name="name">project.version.list.agile</field>
        <field name="model">project.version</field>
        <field name="inherit_id" ref="agile_version.project_version_tree"/>
        <field name="arch" type="xml">
            <field name="project_id" position="after">
                <field name="release_date" optional="show"/>
                <field name="state" optional="show"/>
                <field name="issue_count" optional="hide"/>
                <field name="done_issue_count" optional="hide"/>
                <field name="open_issue_count" optional="show" width="120px" decoration-warning="open_issue_count &gt; 0"/>
                <field name="canceled_issue_count" optional="hide"/>
                <field name="is_ready" optional="show" width="90px"/>
            </field>
        </field>
    </record>

    <record id="project_version_form_project_navigation" model="ir.ui.view">
        <field name="name">project.form.releases.navigation</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="agile_version.project_project_version_form"/>
        <field name="arch" type="xml">
            <page name="version" position="attributes">
                <attribute name="invisible">agile_enabled</attribute>
            </page>
            <page name="version" position="after">
                <page name="agile_releases" string="Releases" invisible="not agile_enabled">
                    <field name="version_ids" readonly="1" nolabel="1">
                        <list create="0" edit="0" delete="0" open_form_view="1">
                            <field name="name"/>
                            <field name="release_date"/>
                            <field name="state"/>
                            <field name="issue_count"/>
                            <field name="done_issue_count"/>
                            <field name="open_issue_count" decoration-warning="open_issue_count &gt; 0"/>
                            <field name="canceled_issue_count"/>
                            <field name="is_ready"/>
                        </list>
                    </field>
                    <p class="text-muted">Create and manage releases from Project → Configuration → Releases. Releasing does not complete a linked milestone.</p>
                </page>
            </page>
        </field>
    </record>

    <record id="agile_version.menu_action_project_version" model="ir.ui.menu">
        <field name="name">Releases and Versions</field>
        <field name="group_ids" eval="[(6, 0, [ref('project.group_project_user')])]"/>
    </record>
    <record id="agile_version.action_project_version" model="ir.actions.act_window">
        <field name="name">Releases and Versions</field>
    </record>
</odoo>
