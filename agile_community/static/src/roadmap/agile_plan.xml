<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="agile_community.Plan">
        <section class="o_ag_plan" aria-label="Plan">
            <div t-if="this.state.error" class="alert alert-danger" role="alert">
                <p class="mb-2" t-out="this.state.error"/>
                <button type="button" class="btn btn-secondary" t-on-click="() => this.load(this.props)">Retry</button>
            </div>
            <p t-elif="this.state.loading and !this.state.data" class="text-muted" role="status">Loading the plan...</p>
            <t t-elif="this.state.data">
                <div class="o_ag_plan_bar">
                    <button t-if="this.state.data.can_create" type="button" class="btn btn-primary o_ag_plan_new_initiative" t-on-click="() => this.openNew('initiative')">
                        New <t t-out="this.label('initiative').toLowerCase()"/></button>
                    <button t-if="this.state.data.can_create" type="button" class="btn btn-secondary o_ag_plan_new_theme" t-on-click="() => this.openNew('theme')">
                        New <t t-out="this.label('theme').toLowerCase()"/></button>
                    <button t-if="this.state.data.can_rename" type="button" class="btn btn-link o_ag_plan_rename" t-on-click="this.openRename">Rename levels</button>
                    <button type="button" class="btn btn-secondary o_ag_plan_download_csv" t-on-click="this.downloadCsv">Download CSV</button>
                    <button t-if="!this.ui.isSmall()" type="button" class="btn btn-secondary o_ag_plan_print" t-on-click="this.printLayout">Print layout</button>
                    <span class="o_ag_plan_limit text-muted" t-out="this.state.data.item_count + ' of ' + this.state.data.limits.items + ' plan items'"/>
                </div>
                <div class="o_ag_plan_bar o_ag_plan_scenarios">
                    <label>Scenario <select class="form-select o_ag_plan_scenario_pick" t-on-change="this.onPickScenario">
                            <option value="0" t-att-selected="!this.state.scenario">Baseline (live plan)</option>
                            <option t-foreach="this.state.scenarios" t-as="scn" t-key="scn.id" t-att-value="scn.id" t-att-selected="this.state.scenario === scn.id" t-out="scn.name"/></select></label>
                    <button t-if="this.state.data.can_create" type="button" class="btn btn-secondary o_ag_plan_new_scenario" t-on-click="() => this.state.naming = ''">New scenario</button>
                </div>
                <form t-if="this.state.naming !== null" class="o_ag_plan_form o_ag_plan_scenario_form" t-on-submit.prevent="this.createScenario">
                    <label>Scenario name <input class="form-control o_ag_plan_scenario_name" maxlength="80" t-model="this.agileModel(this.state, 'naming')"/></label>
                    <p class="text-muted o_ag_plan_hint">It starts as a copy of the live dates of the epics in this view. The live plan does not change until you apply it.</p>
                    <button type="submit" class="btn btn-primary o_ag_plan_scenario_create">Create</button>
                    <button type="button" class="btn btn-secondary" t-on-click="() => this.state.naming = null">Cancel</button>
                </form>
                <div t-if="this.state.scenario" class="btn-group o_ag_plan_scenario_view" role="group" aria-label="Scenario view">
                    <button type="button" t-attf-class="btn btn-secondary o_ag_plan_view_compare {{this.state.scenarioView === 'compare' ? 'active' : ''}}"
                            t-att-aria-pressed="this.state.scenarioView === 'compare' ? 'true' : 'false'" t-on-click="() => this.state.scenarioView = 'compare'">Compare</button>
                    <button type="button" t-attf-class="btn btn-secondary o_ag_plan_view_board {{this.state.scenarioView === 'board' ? 'active' : ''}}"
                            t-att-aria-pressed="this.state.scenarioView === 'board' ? 'true' : 'false'" t-on-click="() => this.state.scenarioView = 'board'">Program board</button>
                </div>
                <AgilePlanBoard t-if="this.state.scenario and this.state.scenarioView === 'board'" scenarioId="this.state.scenario" onChange="() => this.reloadAfterApply()"/>
                <AgilePlanScenario t-elif="this.state.scenario" scenarioId="this.state.scenario" onChange="() => this.reloadAfterApply()" onDelete="() => this.onScenarioDeleted()"/>
                <p t-if="this.state.notice" class="o_ag_plan_notice" role="status" aria-live="polite" t-out="this.state.notice"/>

                <form t-if="this.state.labels" class="o_ag_plan_form o_ag_plan_labels" t-on-submit.prevent="this.saveRename">
                    <label>Top level <input class="form-control" maxlength="30" t-model="this.agileModel(this.state.labels, 'theme')"/></label>
                    <label>Second level <input class="form-control" maxlength="30" t-model="this.agileModel(this.state.labels, 'initiative')"/></label>
                    <button type="submit" class="btn btn-primary">Save names</button>
                    <button type="button" class="btn btn-secondary" t-on-click="() => this.state.labels = null">Cancel</button>
                </form>

                <form t-if="this.state.form" class="o_ag_plan_form o_ag_plan_item_form" t-on-submit.prevent="this.save">
                    <h2 class="h5" t-out="(this.state.form.id ? 'Change ' : 'New ') + this.label(this.state.form.level).toLowerCase()"/>
                    <label>Name <input class="form-control o_ag_plan_name" maxlength="120" t-model="this.agileModel(this.state.form, 'name')"/></label>
                    <label t-if="this.state.form.level === 'initiative' and this.themes.length">Under <select class="form-select" t-model="this.agileModel(this.state.form, 'parent_id')">
                            <option value="">No <t t-out="this.label('theme').toLowerCase()"/></option>
                            <option t-foreach="this.themes" t-as="choice" t-key="choice.id" t-att-value="choice.id" t-out="choice.name"/></select></label>
                    <label>Owner <select class="form-select" t-model="this.agileModel(this.state.form, 'owner_id')">
                            <option value="">Nobody</option>
                            <option t-foreach="this.state.data.people" t-as="person" t-key="person.id" t-att-value="person.id" t-out="person.name"/></select></label>
                    <label>Start <input type="date" class="form-control" t-model="this.agileModel(this.state.form, 'date_start')"/></label>
                    <label>End <input type="date" class="form-control" t-model="this.agileModel(this.state.form, 'date_end')"/></label>
                    <p class="text-muted o_ag_plan_hint">Leave the dates empty to use the dates of the epics.</p>
                    <button type="submit" class="btn btn-primary o_ag_plan_save">Save</button>
                    <button type="button" class="btn btn-secondary" t-on-click="this.closeForm">Cancel</button>
                </form>

                <div t-if="this.isEmpty" class="o_ag_plan_empty">
                    <p>No plan items yet. Use "New <t t-out="this.label('initiative').toLowerCase()"/>" to group epics, and "New <t t-out="this.label('theme').toLowerCase()"/>" to group those. Nothing changes in your projects.</p>
                    <p t-if="!this.state.data.can_create" class="text-muted">Ask a project manager to create the first one.</p>
                </div>
                <ul t-else="" class="o_ag_plan_tree list-unstyled" role="tree" aria-label="Plan">
                    <t t-foreach="this.rows" t-as="row" t-key="row_index">
                        <li t-if="row.type === 'item'" t-attf-class="o_ag_plan_item level_{{row.item.level}}" role="treeitem"
                            t-attf-style="--depth: {{row.depth}}" t-att-aria-expanded="this.hasBody(row.item) ? (this.isOpen(row.item) ? 'true' : 'false') : false" t-att-data-id="row.item.id">
                            <button t-if="this.hasBody(row.item)" type="button" class="o_ag_rm_chevron"
                                    t-att-aria-label="'Show what is in ' + row.item.name" t-on-click="() => this.toggle(row.item)" t-out="this.isOpen(row.item) ? '▾' : '▸'"/>
                            <span t-else="" class="o_ag_rm_chevron_gap"/>
                            <div class="o_ag_plan_body">
                                <div class="o_ag_plan_head">
                                    <span class="badge text-bg-light o_ag_plan_level" t-out="this.label(row.item.level)"/>
                                    <strong class="o_ag_plan_title" t-out="row.item.name"/>
                                    <span t-if="row.item.owner" class="text-muted" t-out="row.item.owner"/>
                                </div>
                                <div class="o_ag_plan_meta">
                                    <t t-set="span" t-value="this.dates(row.item)"/>
                                    <span t-if="span" class="o_ag_plan_dates" t-att-class="span.fromEpics ? 'o_ag_plan_from_epics' : ''">
                                        <t t-out="span.start"/> to <t t-out="span.end"/><t t-if="span.fromEpics"> (from epics)</t></span>
                                    <span class="o_ag_plan_progress_text" t-out="this.progress(row.item)"/>
                                    <progress t-if="row.item.total" max="100" t-att-value="this.fill(row.item)" t-att-aria-label="this.progress(row.item)"/>
                                    <span class="text-muted" t-out="row.item.epic_count + (row.item.epic_count === 1 ? ' epic' : ' epics')"/>
                                    <span t-if="row.item.hidden_total" class="text-muted o_ag_plan_hidden" t-out="'plus ' + row.item.hidden_total + (row.item.hidden_total === 1 ? ' epic you cannot see' : ' epics you cannot see')"/>
                                </div>
                                <div t-if="row.item.can_edit or this.state.data.can_rename" class="o_ag_plan_actions">
                                    <button t-if="row.item.can_edit" type="button" class="btn btn-link btn-sm o_ag_plan_edit" t-att-aria-label="'Change ' + row.item.name" t-on-click="() => this.openEdit(row.item)">Change</button>
                                    <button t-if="this.state.data.can_rename" type="button" class="btn btn-link btn-sm o_ag_plan_delete" t-att-aria-label="'Delete ' + row.item.name" t-on-click="() => this.remove(row.item)">Delete</button>
                                    <label t-if="this.state.data.unplanned.length and this.state.data.can_create" class="o_ag_plan_add">
                                        <span class="visually-hidden">Add an epic to <t t-out="row.item.name"/></span>
                                        <select class="form-select form-select-sm o_ag_plan_add_epic" t-on-change="(ev) => this.onAssign(row.item, ev)">
                                            <option value="">Add an epic...</option>
                                            <option t-foreach="this.state.data.unplanned" t-as="epic" t-key="epic.id" t-att-value="epic.id" t-out="epic.key + ' ' + epic.name"/>
                                        </select></label>
                                </div>
                            </div>
                        </li>
                        <li t-else="" class="o_ag_plan_epic" role="treeitem" t-attf-style="--depth: {{row.depth}}">
                            <span class="o_ag_rm_chevron_gap"/>
                            <div class="o_ag_plan_body">
                                <div class="o_ag_plan_head">
                                    <strong t-out="row.epic.key"/> <span t-out="row.epic.name"/>
                                    <span class="badge text-bg-light" t-out="row.epic.project"/>
                                </div>
                                <div class="o_ag_plan_meta">
                                    <span t-if="row.epic.start" t-out="this.planDate(row.epic.start) + ' to ' + this.planDate(row.epic.end || row.epic.start)"/>
                                    <span class="o_ag_plan_progress_text" t-out="this.progress(row.epic)"/>
                                    <button type="button" class="btn btn-link btn-sm o_ag_plan_remove_epic" t-att-aria-label="'Take ' + row.epic.key + ' out of ' + row.item.name"
                                            t-on-click="() => this.assign(row.epic.id, false)">Take out</button>
                                </div>
                            </div>
                        </li>
                    </t>
                </ul>

                <section t-if="this.state.data.unplanned.length" class="o_ag_plan_unplanned">
                    <h2 class="h5">Epics not in the plan</h2>
                    <ul class="list-unstyled">
                        <li t-foreach="this.state.data.unplanned" t-as="epic" t-key="epic.id" class="o_ag_plan_epic o_ag_plan_unplanned_epic">
                            <div class="o_ag_plan_body">
                                <div class="o_ag_plan_head"><strong t-out="epic.key"/> <span t-out="epic.name"/> <span class="badge text-bg-light" t-out="epic.project"/></div>
                                <div t-if="this.state.data.can_create and this.state.data.choices.length" class="o_ag_plan_actions">
                                    <label><span class="visually-hidden">Place <t t-out="epic.key"/> in the plan</span>
                                        <select class="form-select form-select-sm o_ag_plan_place" t-on-change="(ev) => this.onPlace(epic, ev)">
                                            <option value="">Place in...</option>
                                            <option t-foreach="this.state.data.choices" t-as="choice" t-key="choice.id" t-att-value="choice.id" t-out="this.label(choice.level) + ': ' + choice.name"/>
                                        </select></label>
                                </div>
                            </div>
                        </li>
                    </ul>
                </section>
            </t>
        </section>
    </t>
</templates>
