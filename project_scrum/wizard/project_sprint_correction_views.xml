<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_sprint_correction_wizard_form" model="ir.ui.view">
        <field name="name">project.sprint.correction.wizard.form</field>
        <field name="model">project.sprint.correction.wizard</field>
        <field name="arch" type="xml">
            <form string="Correct Completed Sprint">
                <group>
                    <field name="sprint_id" invisible="1"/>
                    <field name="project_id" invisible="1"/>
                    <field name="operation" widget="radio"/>
                    <field
                        name="task_ids"
                        widget="many2many_tags"
                        domain="[('project_id', '=', project_id)]"
                        options="{'no_create': True, 'no_create_edit': True}"
                    />
                    <field
                        name="reason"
                        placeholder="Explain why this historical sprint needs correction..."
                    />
                </group>
                <div class="alert alert-warning" role="alert">
                    The original plan and close summary stay unchanged. This correction is recorded with your name and reason.
                </div>
                <footer>
                    <button
                        name="action_apply"
                        type="object"
                        string="Apply Correction"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
