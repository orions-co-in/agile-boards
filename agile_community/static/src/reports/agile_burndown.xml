<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="agile_community.Burndown">
        <header class="o_ag_reports_head">
            <h1 class="o_ag_reports_title" t-out="this.title"/>
            <div class="o_ag_reports_controls">
                <label class="o_ag_reports_control"><span t-out="this.props.kind === 'epic' ? 'Epic' : 'Release'"/>
                    <select class="form-select o_ag_burndown_target" t-on-change="this.onTarget">
                        <option t-foreach="this.props.targets" t-as="target" t-key="target.id" t-att-value="target.id"
                                t-att-selected="target.id === this.state.targetId">
                            <t t-if="target.key"><t t-out="target.key"/> </t><t t-out="target.name"/>
                        </option>
                    </select></label>
                <label class="o_ag_reports_control"><span>From</span>
                    <input type="date" class="form-control" t-att-value="this.state.from" t-on-change="(ev) => this.onDate('from', ev)"/></label>
                <label class="o_ag_reports_control"><span>To</span>
                    <input type="date" class="form-control" t-att-value="this.state.to" t-on-change="(ev) => this.onDate('to', ev)"/></label>
                <ReportExport t-if="this.state.data and this.state.data.days.length" title="this.exportTitle" table.bind="this.exportTable" png.bind="this.exportPng"/>
            </div>
        </header>
        <p t-if="this.state.targetId === null" class="o_ag_reports_empty">
            <t t-if="this.props.kind === 'epic'">This project has no epics yet. Create an epic and add issues to it to see its burndown.</t>
            <t t-else="">This project has no releases yet. Add a release and set it on issues to see its burndown.</t>
        </p>
        <div t-elif="this.state.error" class="alert alert-danger" role="alert">
            <p class="mb-2" t-out="this.state.error"/>
            <button type="button" class="btn btn-secondary" t-on-click="this.load">Retry</button>
        </div>
        <p t-elif="this.state.data and !this.state.data.days.length" class="o_ag_reports_empty">
            <t t-if="!this.state.data.issue_count">No issues belong to this <t t-out="this.noun"/> yet.</t>
            <t t-else="">No daily figures yet. They are recorded every night, so the chart fills as the days pass.
                <button type="button" class="btn btn-secondary ms-2" t-on-click="this.recordNow">Record today's figures now</button></t>
        </p>
        <t t-elif="this.state.data and this.layout">
            <p class="o_ag_reports_delivered" t-out="this.summary"/>
            <div t-ref="this.chartBox" t-attf-class="o_ag_cfd {{this.state.loading ? 'o_ag_cfd_loading' : ''}}">
                <svg class="o_ag_cfd_chart" t-attf-viewBox="0 0 {{this.layout.chart.w}} {{this.layout.chart.h}}" role="img"
                     t-att-aria-label="'Burndown: ' + this.unitWord(this.state.data.estimate_unit) + ' left each day against the total. The numbers table has the same figures.'"
                     t-on-mousemove="this.onMove" t-on-mouseleave="this.onLeave" t-on-click="this.onChartClick">
                    <g class="o_ag_cfd_axis">
                        <text class="o_ag_axis_title" t-att-x="this.layout.chart.left + (this.layout.chart.w - this.layout.chart.left - this.layout.chart.right) / 2" t-att-y="this.layout.chart.h - 3" text-anchor="middle">Day</text>
                        <text class="o_ag_axis_title" transform="rotate(-90)" t-att-x="-(this.layout.chart.top + (this.layout.chart.h - this.layout.chart.top - this.layout.chart.bottom) / 2)" y="10" text-anchor="middle" t-out="this.unitWord(this.state.data.estimate_unit) + ' left'"/>
                        <line t-att-x1="this.layout.chart.left" t-att-x2="this.layout.chart.w - this.layout.chart.right" t-att-y1="this.layout.y(0)" t-att-y2="this.layout.y(0)"/>
                        <text t-att-x="this.layout.chart.left - 6" t-att-y="this.layout.y(this.layout.top) + 4" text-anchor="end" t-out="this.layout.top"/>
                        <text t-att-x="this.layout.chart.left - 6" t-att-y="this.layout.y(0)" text-anchor="end">0</text>
                        <text t-att-x="this.layout.x(0)" t-att-y="this.layout.chart.h - 20" t-out="this.state.data.days[0].date"/>
                        <text t-if="this.state.data.days.length > 1" t-att-x="this.layout.x(this.state.data.days.length - 1)" t-att-y="this.layout.chart.h - 20"
                              text-anchor="end" t-out="this.state.data.days[this.state.data.days.length - 1].date"/>
                    </g>
                    <polygon class="o_ag_burndown_area" t-att-points="this.layout.area"/>
                    <polyline class="o_ag_burndown_remaining" t-att-points="this.layout.remainingLine" fill="none"/>
                    <polyline class="o_ag_burndown_scope" t-att-points="this.layout.scopeLine" fill="none"/>
                    <g class="o_ag_burndown_dots">
                        <circle t-foreach="this.state.data.days" t-as="day" t-key="day.date" r="3"
                                t-att-cx="this.layout.x(day_index)" t-att-cy="this.layout.y(day.remaining)"/>
                    </g>
                    <line t-if="this.hoverDay" class="o_ag_cfd_cursor" t-att-x1="this.layout.x(this.state.hover)" t-att-x2="this.layout.x(this.state.hover)"
                          t-att-y1="this.layout.chart.top" t-att-y2="this.layout.y(0)"/>
                </svg>
                <ul class="o_ag_cfd_key">
                    <li><i class="o_ag_cfd_swatch o_ag_burndown_swatch_remaining"/><span><t t-out="this.unitWord(this.state.data.estimate_unit)"/> left</span></li>
                    <li><i class="o_ag_cfd_swatch o_ag_burndown_swatch_scope"/><span>Total (scope)</span></li>
                </ul>
                <p class="o_ag_cfd_readout" aria-live="polite">
                    <t t-if="this.hoverDay"><strong t-out="this.hoverDay.date"/>: <t t-out="this.hoverDay.remaining"/> left of <t t-out="this.hoverDay.scope"/> <t t-out="this.unitWord(this.state.data.estimate_unit)"/>, <t t-out="this.hoverDay.issues"/> issues.</t>
                    <t t-else="">Point at the chart for a day's figures. Click to open the issues still open that day.</t>
                </p>
            </div>
            <button type="button" class="btn btn-link o_ag_cfd_toggle" t-att-aria-expanded="this.state.table ? 'true' : 'false'" t-on-click="this.toggleTable">
                <t t-if="this.state.table">Hide the numbers</t><t t-else="">Show the numbers</t>
            </button>
            <div t-if="this.state.table" class="o_ag_cfd_table_wrap">
                <table class="table table-sm o_ag_reports_table">
                    <thead><tr><th>Day</th><th class="text-end">Left</th><th class="text-end">Done</th><th class="text-end">Scope</th><th class="text-end">Issues</th></tr></thead>
                    <tbody>
                        <tr t-foreach="this.state.data.days" t-as="day" t-key="day.date">
                            <td><button type="button" class="btn btn-link p-0" t-att-aria-label="'Open the issues still open on ' + day.date"
                                        t-on-click="() => this.open(day.date)" t-out="day.date"/></td>
                            <td class="text-end" t-out="day.remaining"/>
                            <td class="text-end" t-out="day.done"/>
                            <td class="text-end" t-out="day.scope"/>
                            <td class="text-end" t-out="day.issues"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
        <p t-else="" class="text-muted" role="status">Loading the report...</p>
    </t>
</templates>
