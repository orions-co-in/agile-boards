<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="agile_project_quick_filter_list" model="ir.ui.view">
        <field name="name">agile.project.quick.filter.list</field>
        <field name="model">agile.project.quick.filter</field>
        <field name="arch" type="xml">
            <list default_order="sequence, name" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="filter_type"/>
                <field name="user_id" optional="show"/>
                <field name="priority" optional="show"/>
                <field name="issue_type_id" optional="show"/>
                <field name="component_id" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="agile_project_quick_filter_form" model="ir.ui.view">
        <field name="name">agile.project.quick.filter.form</field>
        <field name="model">agile.project.quick.filter</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="e.g. Urgent bugs"/></h1></div>
                    <group>
                        <field name="project_id" readonly="id"/>
                        <field name="member_user_ids" invisible="1"/>
                        <field name="sequence"/>
                        <field name="active" widget="boolean_toggle"/>
                        <field name="filter_type"/>
                        <field name="user_id" invisible="filter_type != 'assignee'" domain="[('id', 'in', member_user_ids)]" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="priority" invisible="filter_type != 'priority'"/>
                        <field name="issue_type_id" invisible="filter_type != 'issue_type'" domain="['|', ('project_ids', '=', False), ('project_ids', '=', project_id)]" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="component_id" invisible="filter_type != 'component'" domain="[('project_id', '=', project_id)]" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
