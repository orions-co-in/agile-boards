<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="project_sprint_view_form" model="ir.ui.view">
        <field name="name">project.sprint.view.form</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_start"
                        string="Start"
                        type="object"
                        invisible="state != 'draft'"
                        class="btn btn-primary"
                        groups="project.group_project_manager"
                        confirm="Starting freezes the current plan, estimates, assignees, and capacity. Review unestimated issues and capacity warnings below."
                    />
                    <button
                        name="%(project_scrum.action_project_sprint_close)d"
                        string="Complete"
                        type="action"
                        invisible="state != 'in_progress'"
                        class="btn btn-primary"
                        groups="project.group_project_manager"
                    />
                    <button
                        name="action_open_correction"
                        string="Correct"
                        type="object"
                        invisible="state != 'done'"
                        groups="project.group_project_manager"
                    />
                    <button
                        name="action_confirm_plan"
                        string="Confirm Plan"
                        type="object"
                        invisible="state != 'draft' or planning_confirmed"
                        class="btn btn-primary"
                        groups="project.group_project_manager"
                    />
                    <field name="planning_confirmed" invisible="1" />
                    <field name="planning_stale" invisible="1" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,in_progress,done"
                    />
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="not planning_confirmed or state != 'draft'">
                        Plan confirmed: <field name="committed_task_count" nolabel="1"/> issues.
                        Replanning requires a reason and preserves the prior snapshot.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not planning_stale">
                        This plan changed after confirmation. Update the plan and enter a reason before starting.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not unestimated_issue_count">
                        <field name="unestimated_issue_count" nolabel="1"/> planned issue(s) have no estimate.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not over_capacity">
                        Planned points exceed active member capacity. You may still start after reviewing the plan.
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_tasks"
                            type="object"
                            class="oe_stat_button"
                            icon="checklist"
                        >
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="tasks_count" nolabel="1" />
                                </span>
                                <span class="o_stat_text">
                                Tasks
                            </span>
                            </div>
                        </button>
                    </div>
                    <label for="name" class="oe_edit_only " />
                    <h1>
                        <field name="name" readonly="state != 'draft'" />
                    </h1>
                    <group>
                        <group class="o_agile_label_col">
                            <field
                                name="user_ids"
                                widget="many2many_avatar_user"
                                readonly="state != 'draft'"
                                invisible="state != 'draft' and not user_ids"
                            />
                            <field name="project_id" readonly="state != 'draft'" />
                        </group>
                        <group class="o_agile_label_col">
                            <field name="date_start" readonly="state != 'draft'" />
                            <field name="date_option" readonly="state != 'draft'" />
                            <field
                                name="date_end"
                                readonly="date_option != 'custom' or state != 'draft'"
                                force_save="1"
                            />
                        </group>
                        <field name="description" readonly="state != 'draft'" />
                    </group>
                    <group string="Delivery summary" invisible="state != 'done'">
                        <field name="close_summary" readonly="1" />
                        <field name="completed_task_count" readonly="1" />
                        <field name="committed_task_count" readonly="1" />
                        <field name="completed_points" readonly="1" />
                        <field name="committed_points_at_close" readonly="1" />
                    </group>
                    <group string="Sprint capacity">
                        <group class="o_agile_label_col">
                            <field name="planned_points" readonly="1" />
                            <field name="unestimated_issue_count" readonly="1" />
                        </group>
                        <group class="o_agile_label_col">
                            <field name="capacity_points" readonly="1" />
                            <field name="over_capacity" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Capacity" name="capacity">
                            <field
                                name="capacity_ids"
                                readonly="state != 'draft'"
                                groups="project.group_project_manager"
                                context="{'default_sprint_id': id}"
                            >
                                <list editable="bottom" create="1" edit="1" delete="1">
                                    <field name="sprint_id" column_invisible="1" />
                                    <field name="sprint_member_ids" column_invisible="1" />
                                    <field
                                        name="user_id"
                                        domain="[('share', '=', False), ('id', 'in', sprint_member_ids)]"
                                        options="{'no_create': True}"
                                    />
                                    <field name="capacity_points" />
                                    <field name="planned_points" readonly="1" />
                                    <field name="over_capacity" readonly="1" />
                                </list>
                            </field>
                            <field
                                name="capacity_ids"
                                readonly="1"
                                groups="project.group_project_user,!project.group_project_manager"
                            >
                                <list create="0" edit="0" delete="0">
                                    <field name="sprint_id" column_invisible="1" />
                                    <field name="user_id" />
                                    <field name="capacity_points" />
                                    <field name="planned_points" />
                                    <field name="over_capacity" />
                                </list>
                            </field>
                            <div groups="project.group_project_user" class="alert alert-info" role="status">
                                Member capacity is entered in points. Shared issues split their points evenly across active assignees; canceled issues and inactive users are excluded.
                            </div>
                        </page>
                        <page string="Scope changes" name="scope_changes">
                            <field name="scope_change_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="sprint_id" column_invisible="1" />
                                    <field name="create_date" />
                                    <field name="operation" />
                                    <field name="task_name" />
                                    <field name="reason" />
                                    <field name="user_id" />
                                </list>
                            </field>
                            <button name="action_open_scope_change" type="object" string="Update Plan" class="btn-primary" groups="project.group_project_manager" invisible="state != 'draft'" />
                        </page>
                        <page string="Plan history" name="plan_history">
                            <field name="commitment_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="revision" />
                                    <field name="create_date" />
                                    <field name="reason" />
                                    <field name="task_count" />
                                    <field name="user_id" />
                                    <field name="line_ids">
                                        <list create="0" edit="0" delete="0">
                                            <field name="commitment_id" column_invisible="1" />
                                            <field name="issue_key" />
                                            <field name="task_name" />
                                            <field name="estimated_snapshot" />
                                            <field name="story_points_snapshot" />
                                            <field name="has_sprint_children" />
                                        </list>
                                    </field>
                                    <field name="capacity_line_ids">
                                        <list create="0" edit="0" delete="0">
                                            <field name="user_name" />
                                            <field name="capacity_points" />
                                        </list>
                                    </field>
                                </list>
                            </field>
                        </page>
                        <page string="Corrections" name="corrections" invisible="state != 'done'">
                            <field name="correction_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="create_date" />
                                    <field name="issue_key" />
                                    <field name="task_name" />
                                    <field name="operation" />
                                    <field name="reason" />
                                    <field name="user_id" />
                                    <field name="state" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="project_sprint_view_tree" model="ir.ui.view">
        <field name="name">project.sprint.view.list</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="project_id" />
                <field name="date_start" />
                <field name="date_end" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="project_sprint_view_search" model="ir.ui.view">
        <field name="name">project.sprint.view.search</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="project_id" />
                <separator />
                <filter
                    string="Draft"
                    name="draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    string="In Progress"
                    name="progress"
                    domain="[('state', '=', 'in_progress')]"
                />
                <filter string="Done" name="done" domain="[('state', '=', 'done')]" />
                <separator />
                <filter name="date_start" string="Date Start" date="date_start" />
                <filter name="date_end" string="Date End" date="date_end" />
                <separator />
                <group>
                    <filter
                        name="project_id"
                        string="Project"
                        context="{'group_by':'project_id'}"
                    />
                    <filter
                        name="state"
                        string="State"
                        context="{'group_by':'state'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="project_sprint_action" model="ir.actions.act_window">
        <field name="name">Sprints</field>
        <field name="res_model">project.sprint</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="project_sprint_menu"
        name="Sprints"
        parent="project.menu_project_config"
        action="project_sprint_action"
        sequence="10"
        groups="project.group_project_manager"
    />
</odoo>
