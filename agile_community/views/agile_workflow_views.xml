<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Workflow editor (W-203): a form with a flow picture over two editable lists. -->
    <record id="agile_workflow_view_list" model="ir.ui.view">
        <field name="name">agile.workflow.list</field>
        <field name="model">agile.workflow</field>
        <field name="arch" type="xml">
            <list string="Workflows">
                <header>
                    <button name="action_open_template_wizard" type="object" string="Import file" display="always"/>
                </header>
                <field name="name"/>
                <field name="is_default" string="Default"/>
                <field name="task_type_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="agile_workflow_view_form" model="ir.ui.view">
        <field name="name">agile.workflow.form</field>
        <field name="model">agile.workflow</field>
        <field name="arch" type="xml">
            <form string="Workflow">
                <header>
                    <button name="action_open_template_wizard" type="object" string="Share" invisible="not id"/>
                    <button name="action_reset_to_default" type="object" string="Reset to default"
                            invisible="is_default or not id"
                            confirm="Replace this workflow's statuses and moves with the default?"/>
                </header>
                <sheet>
                    <field name="project_id" invisible="1"/>
                    <field name="is_default" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Workflow name"/></h1>
                    </div>
                    <group>
                        <field name="task_type_ids" widget="many2many_tags" invisible="is_default"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <div class="text-muted" colspan="2" invisible="not is_default">
                            Used by every issue type that has no workflow of its own.
                        </div>
                    </group>
                    <field name="diagram" widget="agile_workflow_diagram" nolabel="1"/>
                    <div class="text-muted">
                        The Backlog holds issues that are not in a sprint, so it is not a board column. Planning an issue
                        into a sprint moves it to To Do; taking it out of a sprint sends a To Do issue back to the Backlog.
                        The board shows the sprint's statuses, To Do to Done.
                    </div>
                    <separator string="Statuses"/>
                    <field name="status_ids" nolabel="1">
                        <list editable="bottom" default_order="sequence, id">
                            <field name="sequence" widget="handle"/>
                            <field name="stage_id" options="{'no_create': True, 'no_create_edit': True}"
                                   domain="[('project_ids', 'in', parent.project_id)]"/>
                            <field name="name" column_invisible="1"/>
                            <field name="stage_active" column_invisible="1"/>
                            <field name="can_delete" column_invisible="1"/>
                            <field name="category" string="Meaning"/>
                            <field name="issue_count" string="Issues"/>
                        </list>
                    </field>
                    <div class="text-muted">
                        Use Add status on the flow picture above to create a status; the list shows every status of this workflow.
                    </div>
                    <separator string="Moves"/>
                    <field name="transition_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="name" string="Button"/>
                            <field name="from_status_id" string="From" options="{'no_create': True}"/>
                            <field name="to_status_id" string="To" options="{'no_create': True}"/>
                            <field name="allow_contributor" string="Contributors" widget="boolean_toggle"/>
                            <field name="allow_reviewer" string="Reviewers" widget="boolean_toggle"/>
                            <field name="allow_manager" string="Managers" widget="boolean_toggle"/>
                            <field name="required_field_ids" string="Needs" widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="require_no_open_subtasks" string="No open sub-issues" widget="boolean_toggle"/>
                            <field name="require_not_blocked" string="Not blocked" widget="boolean_toggle"/>
                        </list>
                    </field>
                    <div class="text-muted">
                        A move without a button (for example Backlog to In Progress) works by dragging the card,
                        the Move-to list or the status bar.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="agile_project_workflows_button" model="ir.ui.view">
        <field name="name">project.project.form.agile.workflows</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="agile_community.agile_project_settings_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='agile_tool_components']" position="after">
                <div class="o_agile_tool" name="agile_tool_workflows" colspan="2">
                    <button name="action_open_agile_workflows" type="object" string="Workflows" class="btn-secondary"/>
                    <span class="o_agile_tool_help">The statuses issues move through, who may make each move and what an issue needs first. Backlog sits outside the sprint; To Do to Done is the sprint board. Managers only.</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
