<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="agile_community.ControlChart">
        <header class="o_ag_reports_head">
            <h1 class="o_ag_reports_title">How long does an issue take?</h1>
            <div class="o_ag_reports_controls">
                <label class="o_ag_reports_control"><span>From</span>
                    <input type="date" class="form-control" t-att-value="this.state.from" t-on-change="(ev) => this.onDate('from', ev)"/></label>
                <label class="o_ag_reports_control"><span>To</span>
                    <input type="date" class="form-control" t-att-value="this.state.to" t-on-change="(ev) => this.onDate('to', ev)"/></label>
                <ReportExport t-if="this.state.data and this.state.data.issues.length" title="this.exportTitle" table.bind="this.exportTable" png.bind="this.exportPng"/>
            </div>
        </header>
        <div t-if="this.state.error" class="alert alert-danger" role="alert">
            <p class="mb-2" t-out="this.state.error"/>
            <button type="button" class="btn btn-secondary" t-on-click="this.load">Retry</button>
        </div>
        <p t-elif="this.state.data and !this.state.data.issues.length" class="o_ag_reports_empty">
            No issue was started and finished between these dates. Cycle time runs from the first time an issue enters In Progress to the first time it enters Done.
        </p>
        <t t-elif="this.state.data and this.layout">
            <p class="o_ag_reports_delivered" t-out="this.summary"/>
            <p t-if="this.state.data.hidden" class="text-muted">
                <t t-out="this.state.data.hidden"/> more finished, but you cannot see them.
            </p>
            <div t-ref="this.chartBox" t-attf-class="o_ag_cfd {{this.state.loading ? 'o_ag_cfd_loading' : ''}}">
                <svg class="o_ag_cfd_chart" t-attf-viewBox="0 0 {{this.layout.chart.w}} {{this.layout.chart.h}}" role="img"
                     aria-label="Control chart: days each finished issue took, with the rolling average. The numbers table has the same figures."
                     t-on-mousemove="this.onMove" t-on-mouseleave="this.onLeave">
                    <g class="o_ag_cfd_axis">
                        <text class="o_ag_axis_title" t-att-x="this.layout.chart.left + (this.layout.chart.w - this.layout.chart.left - this.layout.chart.right) / 2" t-att-y="this.layout.chart.h - 3" text-anchor="middle">Date finished</text>
                        <text class="o_ag_axis_title" transform="rotate(-90)" t-att-x="-(this.layout.chart.top + (this.layout.chart.h - this.layout.chart.top - this.layout.chart.bottom) / 2)" y="10" text-anchor="middle" t-out="'Days to finish'"/>
                        <line t-att-x1="this.layout.chart.left" t-att-x2="this.layout.chart.w - this.layout.chart.right" t-att-y1="this.layout.y(0)" t-att-y2="this.layout.y(0)"/>
                        <text t-att-x="this.layout.chart.left - 6" t-att-y="this.layout.y(this.layout.top) + 4" text-anchor="end" t-out="this.layout.top"/>
                        <text t-att-x="this.layout.chart.left - 6" t-att-y="this.layout.y(0)" text-anchor="end">0</text>
                        <text t-att-x="this.layout.chart.left" t-att-y="this.layout.chart.h - 20" t-out="this.state.data.from"/>
                        <text t-att-x="this.layout.chart.w - this.layout.chart.right" t-att-y="this.layout.chart.h - 20" text-anchor="end" t-out="this.state.data.to"/>
                    </g>
                    <line class="o_ag_control_average" t-att-x1="this.layout.chart.left" t-att-x2="this.layout.chart.w - this.layout.chart.right"
                          t-att-y1="this.layout.averageY" t-att-y2="this.layout.averageY"/>
                    <polyline class="o_ag_burndown_remaining" t-att-points="this.layout.rollingLine" fill="none"/>
                    <g class="o_ag_burndown_dots">
                        <circle t-foreach="this.layout.dots" t-as="dot" t-key="dot_index" r="4"
                                t-att-cx="dot.cx" t-att-cy="dot.cy" t-att-class="dot_index === this.state.hover ? 'o_ag_control_hot' : ''"/>
                    </g>
                </svg>
                <ul class="o_ag_cfd_key">
                    <li><i class="o_ag_cfd_swatch o_ag_burndown_swatch_remaining"/><span>Average of the last <t t-out="this.state.data.window"/></span></li>
                    <li><i class="o_ag_cfd_swatch o_ag_burndown_swatch_scope"/><span>Average of all</span></li>
                </ul>
                <p class="o_ag_cfd_readout" aria-live="polite">
                    <t t-if="this.hoverIssue"><strong t-out="this.hoverIssue.key"/> <t t-out="this.hoverIssue.name"/>: <t t-out="this.hoverIssue.days"/> days, finished <t t-out="this.hoverIssue.date"/>.</t>
                    <t t-else="">Point at a dot for the issue and its days.</t>
                </p>
            </div>
            <button type="button" class="btn btn-link o_ag_cfd_toggle" t-att-aria-expanded="this.state.table ? 'true' : 'false'" t-on-click="this.toggleTable">
                <t t-if="this.state.table">Hide the numbers</t><t t-else="">Show the numbers</t>
            </button>
            <div t-if="this.state.table" class="o_ag_cfd_table_wrap">
                <table class="table table-sm o_ag_reports_table">
                    <thead><tr><th>Key</th><th>Title</th><th>Finished</th><th class="text-end">Days</th><th class="text-end">Average of the last <t t-out="this.state.data.window"/></th></tr></thead>
                    <tbody>
                        <tr t-foreach="this.state.data.issues" t-as="issue" t-key="issue_index">
                            <td t-out="issue.key"/>
                            <td t-out="issue.name"/>
                            <td t-out="issue.date"/>
                            <td class="text-end" t-out="issue.days"/>
                            <td class="text-end" t-out="issue.rolling"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
        <p t-else="" class="text-muted" role="status">Loading the report...</p>
    </t>
</templates>
