<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="agile_community.InlineEditor">
        <div class="o_ag_inline p-2" t-on-keydown="this.onKeydown">
            <label class="o_ag_inline_label d-block mb-1" t-att-for="'o_ag_inline_input'" t-out="this.props.label"/>
            <input t-if="this.props.kind === 'number'" id="o_ag_inline_input" t-ref="this.inputRef" type="text" inputmode="decimal"
                   class="form-control form-control-sm" t-model="this.agileModel(this.state, 'value')" t-att-disabled="this.state.saving"
                   t-att-aria-invalid="this.state.error ? 'true' : 'false'" placeholder="Not estimated"/>
            <select t-else="" id="o_ag_inline_input" t-ref="this.inputRef" class="form-select form-select-sm"
                    t-model="this.agileModel(this.state, 'value')" t-att-disabled="this.state.saving" t-on-change="this.save">
                <option t-foreach="this.props.options" t-as="option" t-key="option.id" t-att-value="option.id" t-out="option.label"/>
            </select>
            <p t-if="this.state.error" class="o_ag_inline_error text-danger small mt-1 mb-0" role="alert" t-out="this.state.error"/>
            <p class="text-muted small mt-1 mb-0">Enter saves, Esc cancels.</p>
        </div>
    </t>
</templates>
