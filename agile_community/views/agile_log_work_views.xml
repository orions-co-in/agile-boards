<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="agile_log_work_form" model="ir.ui.view">
        <field name="name">agile.log.work.form</field>
        <field name="model">agile.log.work</field>
        <field name="arch" type="xml">
            <form string="Log work">
                <group>
                    <field name="task_id" invisible="1"/>
                    <field name="hours" widget="float_time" autofocus="1"/>
                    <field name="date"/>
                    <field name="description" placeholder="Optional note"/>
                </group>
                <footer>
                    <button string="Log work" name="action_log_work" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
