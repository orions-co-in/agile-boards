<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="agile_move_project_form" model="ir.ui.view">
        <field name="name">agile.move.project.form</field>
        <field name="model">agile.move.project</field>
        <field name="arch" type="xml">
            <form string="Move to another project">
                <field name="step" invisible="1"/>
                <field name="task_id" invisible="1"/>
                <field name="source_project_id" invisible="1"/>
                <field name="subtask_count" invisible="1"/>
                <div class="d-flex gap-3 mb-3" role="list" aria-label="Steps">
                    <span role="listitem" class="badge text-bg-primary" invisible="step != 'target'">1 Project (current)</span>
                    <span role="listitem" class="badge text-bg-light" invisible="step == 'target'">1 Project</span>
                    <span role="listitem" class="badge text-bg-primary" invisible="step != 'mapping'">2 Statuses (current)</span>
                    <span role="listitem" class="badge text-bg-light" invisible="step == 'mapping'">2 Statuses</span>
                    <span role="listitem" class="badge text-bg-primary" invisible="step != 'confirm'">3 Confirm (current)</span>
                    <span role="listitem" class="badge text-bg-light" invisible="step == 'confirm'">3 Confirm</span>
                </div>
                <group invisible="step != 'target'">
                    <field name="target_project_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="move_subtasks" invisible="not subtask_count"/>
                </group>
                <div class="alert alert-danger" role="alert" invisible="step != 'target' or not blocker_text">
                    <field name="blocker_text" nolabel="1"/>
                </div>
                <group string="Match each status" invisible="step != 'mapping'">
                    <field name="line_ids" nolabel="1" colspan="2">
                        <list editable="bottom" create="0" delete="0">
                            <field name="source_stage_id"/>
                            <field name="target_stage_id" options="{'no_create': True, 'no_create_edit': True}" required="1"/>
                        </list>
                    </field>
                </group>
                <div invisible="step != 'confirm'">
                    <p class="fw-bold">This is what will happen:</p>
                    <field name="preview_text" nolabel="1"/>
                </div>
                <footer>
                    <button string="Next" name="action_next" type="object" class="btn-primary" invisible="step == 'confirm'"/>
                    <button string="Move the issue" name="action_move" type="object" class="btn-primary" invisible="step != 'confirm'"/>
                    <button string="Back" name="action_back" type="object" invisible="step == 'target'"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_project_task_form_agile_move_project" model="ir.ui.view">
        <field name="name">project.task.form.agile.move.project</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="agile_community.view_project_task_form_agile"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <field name="agile_can_move_project" invisible="1"/>
                <button name="action_agile_move_project" type="object" string="Move to project…" class="btn-secondary"
                        invisible="not agile_can_move_project"/>
            </xpath>
        </field>
    </record>
</odoo>
