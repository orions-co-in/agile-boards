<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="agile_sprint_start_wizard_form" model="ir.ui.view">
        <field name="name">agile.sprint.start.wizard.form</field>
        <field name="model">agile.sprint.start.wizard</field>
        <field name="arch" type="xml">
            <form string="Start sprint">
                <field name="sprint_id" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="not warning">
                    <field name="warning" readonly="1" nolabel="1"/>
                </div>
                <group>
                    <field name="name"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="goal" placeholder="What should this sprint achieve?"/>
                </group>
                <footer>
                    <button string="Start sprint" name="action_start_sprint" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
