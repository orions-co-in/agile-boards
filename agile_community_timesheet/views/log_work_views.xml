<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="agile_log_work_form" model="ir.ui.view">
        <field name="name">agile.log.work.form</field>
        <field name="model">agile.log.work</field>
        <field name="arch" type="xml">
            <form string="Log work">
                <group>
                    <field name="task_id" invisible="1"/>
                    <field name="hours" widget="float_time" autofocus="1"/>
                    <field name="date"/>
                    <field name="description" placeholder="Optional note"/>
                </group>
                <footer>
                    <button string="Log work" name="action_log_work" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_project_task_form_agile_log_work" model="ir.ui.view">
        <field name="name">project.task.form.agile.log.work</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="agile_community.view_project_task_form_agile"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='agile_logged_hours']" position="after">
                <field name="allow_timesheets" invisible="1"/>
                <button name="action_agile_log_work" type="object" string="Log work" class="btn-secondary"
                        invisible="not allow_timesheets or not id"/>
            </xpath>
        </field>
    </record>

    <record id="view_project_task_form_agile_drawer_log_work" model="ir.ui.view">
        <field name="name">project.task.form.agile.drawer.log.work</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="agile_community.view_project_task_form_agile_drawer"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='agile_logged_hours']" position="after">
                <field name="allow_timesheets" invisible="1"/>
                <button name="action_agile_log_work" type="object" string="Log work" class="btn-secondary"
                        invisible="not allow_timesheets or not id"/>
            </xpath>
        </field>
    </record>

    <record id="project_task_kanban_agile_log_work" model="ir.ui.view">
        <field name="name">project.task.kanban.agile.log.work</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="agile_community.project_task_kanban_agile"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_agile_task_actions')]" position="inside">
                <field name="allow_timesheets" invisible="1"/>
                <button name="action_agile_log_work" type="object" title="Log work on this issue" string="Log work"
                        class="btn btn-sm btn-secondary" invisible="not allow_timesheets or not agile_issue"/>
            </xpath>
        </field>
    </record>
</odoo>
