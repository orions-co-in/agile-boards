<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="agile_community.RoadmapShare">
        <section class="o_ag_rm_share" role="dialog" aria-label="Share this roadmap">
            <header class="o_ag_rm_share_head">
                <h2>Share this roadmap</h2>
                <button type="button" class="btn btn-link o_ag_rm_share_close" t-on-click="this.props.onClose">Close</button>
            </header>
            <p class="text-muted">Named people open it read only. They see only the projects and items their own access allows.</p>
            <p t-if="this.state.error" class="alert alert-danger" role="alert" t-out="this.state.error"/>
            <p t-if="this.state.notice" class="o_ag_rm_share_notice" role="status" t-out="this.state.notice"/>
            <p t-if="this.state.loading" class="text-muted" role="status">Loading...</p>
            <t t-else="">
                <form class="o_ag_rm_share_form" t-on-submit="this.create">
                    <label class="o_ag_rm_control"><span>Name</span>
                        <input type="text" class="form-control o_ag_rm_share_name" maxlength="60" t-model="this.agileModel(this.state, 'name')" placeholder="Q1 plan"/></label>
                    <fieldset class="o_ag_rm_share_people">
                        <legend>Share with</legend>
                        <p t-if="!this.state.people.length" class="text-muted">No one else is on your projects yet.</p>
                        <label t-foreach="this.state.people" t-as="person" t-key="person.id" class="o_ag_rm_check">
                            <input type="checkbox" t-att-checked="this.state.chosen.includes(person.id)" t-on-change="() => this.toggle(this.state.chosen, person.id)"/>
                            <t t-out="person.name"/>
                        </label>
                    </fieldset>
                    <p class="text-muted">Saves the <t t-out="this.props.projects.length"/> project(s) in view, the Hide done and Epics only choices and the colours.</p>
                    <button type="submit" class="btn btn-primary o_ag_rm_share_create">Share</button>
                </form>
                <h3 t-if="this.state.mine.length">Shared by you</h3>
                <ul t-if="this.state.mine.length" class="o_ag_rm_share_list list-unstyled">
                    <li t-foreach="this.state.mine" t-as="share" t-key="share.id" class="o_ag_rm_share_item">
                        <b t-out="share.name"/> <span class="text-muted">with <t t-out="share.people"/></span>
                        <div t-if="this.state.editing and this.state.editing.id === share.id" class="o_ag_rm_share_edit">
                            <label t-foreach="this.state.people" t-as="person" t-key="person.id" class="o_ag_rm_check">
                                <input type="checkbox" t-att-checked="this.state.editing.chosen.includes(person.id)" t-on-change="() => this.toggle(this.state.editing.chosen, person.id)"/>
                                <t t-out="person.name"/>
                            </label>
                            <button type="button" class="btn btn-primary btn-sm" t-on-click="this.saveEdit">Save people</button>
                        </div>
                        <span class="o_ag_rm_share_actions">
                            <button type="button" class="btn btn-link btn-sm o_ag_rm_share_copy" t-on-click="() => this.copyLink(share)">Copy link</button>
                            <button type="button" class="btn btn-link btn-sm" t-on-click="() => this.startEdit(share)">Change people</button>
                            <button type="button" class="btn btn-link btn-sm text-danger" t-on-click="() => this.remove(share)">Stop sharing</button>
                        </span>
                    </li>
                </ul>
                <h3 t-if="this.state.shared.length">Shared with you</h3>
                <ul t-if="this.state.shared.length" class="o_ag_rm_share_list list-unstyled">
                    <li t-foreach="this.state.shared" t-as="share" t-key="share.id" class="o_ag_rm_share_item">
                        <b t-out="share.name"/> <span class="text-muted">from <t t-out="share.owner"/></span>
                        <button type="button" class="btn btn-link btn-sm o_ag_rm_share_open" t-on-click="() => this.open(share)">Open</button>
                    </li>
                </ul>
            </t>
        </section>
    </t>
</templates>
