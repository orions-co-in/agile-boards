<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="agile_bulk_update_wizard_form" model="ir.ui.view">
        <field name="name">agile.community.bulk.update.wizard.form</field>
        <field name="model">agile_community.bulk_update_wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk update issues">
                <div class="alert alert-info" role="status">
                    <field name="task_count" nolabel="1" readonly="1" class="oe_inline"/>
                    <span> selected. Review the impact preview below. Eligibility is checked again before applying; if any issue cannot be updated, nothing will change.</span>
                </div>
                <group>
                    <field name="task_ids" invisible="1"/>
                    <field name="project_ids" invisible="1"/>
                    <field name="update_assignees"/>
                    <field name="assignee_operation" invisible="not update_assignees" required="update_assignees"/>
                    <field name="assignee_ids" invisible="not update_assignees" required="update_assignees and assignee_operation != 'replace'" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="update_tags"/>
                    <field name="tag_operation" invisible="not update_tags" required="update_tags"/>
                    <field name="tag_ids" invisible="not update_tags" required="update_tags and tag_operation != 'replace'" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="update_sprint"/>
                    <field name="sprint_operation" invisible="not update_sprint" required="update_sprint"/>
                    <field name="sprint_id" invisible="not update_sprint or sprint_operation != 'move'" required="update_sprint and sprint_operation == 'move'" domain="[('project_id', 'in', project_ids), ('state', '!=', 'done')]" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="update_status"/>
                    <field name="stage_id" invisible="not update_status" required="update_status" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="update_priority"/>
                    <field name="priority" invisible="not update_priority" widget="priority"/>
                    <field name="update_points"/>
                    <field name="story_points" invisible="not update_points"/>
                    <field name="update_version"/>
                    <field name="version_id" invisible="not update_version" required="update_version" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="update_epic"/>
                    <field name="epic_id" invisible="not update_epic" options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
                <group string="Impact preview">
                    <field name="preview_result" nolabel="1" readonly="1" class="o_agile_bulk_update_preview"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply changes" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_agile_bulk_update_wizard" model="ir.actions.act_window">
        <field name="name">Agile bulk update</field>
        <field name="res_model">agile_community.bulk_update_wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="agile_bulk_update_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_task_ids': [(6, 0, active_ids)]}</field>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('project.group_project_manager')), (4, ref('project.group_project_user'))]"/>
    </record>
</odoo>
