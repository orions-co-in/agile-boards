<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="agile_community.Reports">
        <Layout display="this.display" className="'o_ag_reports'">
            <div class="o_ag_reports_body">

                <main class="o_ag_reports_main">
                    <div class="o_ag_reports_switch">
                        <label class="o_ag_reports_control">
                            <span>Report</span>
                            <select class="form-select o_ag_reports_select" aria-label="Switch report" t-on-change="this.onSwitch">
                                <optgroup t-foreach="this.pickerGroups" t-as="group" t-key="group.name" t-att-label="group.name">
                                    <option t-foreach="group.reports" t-as="report" t-key="report.code" t-att-value="report.code"
                                            t-att-selected="this.state.report === report.code" t-out="report.label"/>
                                </optgroup>
                            </select>
                        </label>
                    </div>
                    <AgileCfd t-if="this.state.report === 'cfd' and this.state.meta" projectId="this.projectId" onOpen.bind="this.drill"/>
                    <AgileControlChart t-elif="this.state.report === 'control' and this.state.meta" projectId="this.projectId"/>
                    <AgileDeploys t-elif="this.state.report === 'deploys' and this.state.meta" projectId="this.projectId"/>
                    <AgileBurnup t-elif="this.state.report === 'burnup' and this.state.meta" t-key="this.state.sprintId"
                                 projectId="this.projectId" sprints="this.state.meta.sprints.filter((s) => s.state !== 'draft')"
                                 initialSprintId="this.state.sprintId"/>
                    <AgileBurndown t-elif="(this.state.report === 'epic' or this.state.report === 'release') and this.state.meta"
                                   t-key="this.state.report" projectId="this.projectId" kind="this.state.report" onOpen.bind="this.drill" initialTargetId="this.initialTargetId"
                                   targets="this.state.report === 'epic' ? this.state.meta.epics : this.state.meta.releases"/>
                    <t t-elif="this.state.error">
                        <div class="alert alert-danger" role="alert">
                            <p class="mb-2" t-out="this.state.error"/>
                            <button type="button" class="btn btn-secondary" t-on-click="this.load">Retry</button>
                        </div>
                    </t>
                    <t t-elif="this.state.loading and !this.state.data">
                        <p class="o_ag_reports_loading text-muted" role="status">Loading the report...</p>
                    </t>
                    <t t-elif="!this.state.sprintId">
                        <p class="o_ag_reports_empty">Close a sprint to see its report. The current sprint shows its progress so far.</p>
                    </t>
                    <t t-else="">
                        <header class="o_ag_reports_head">
                            <h1 class="o_ag_reports_title" t-out="this.question"/>
                            <label class="o_ag_reports_control">
                                <span>Sprint</span>
                                <select class="form-select" t-on-change="this.onSprint">
                                    <option t-foreach="this.state.meta.sprints" t-as="item" t-key="item.id" t-att-value="item.id"
                                            t-att-selected="item.id === this.state.sprintId">
                                        <t t-out="item.name"/>
                                        <t t-if="item.state === 'in_progress'"> (active)</t>
                                        <t t-elif="item.state === 'draft'"> (planned)</t>
                                    </option>
                                </select>
                            </label>
                            <ReportExport t-if="this.state.data" title="this.exportTitle" table.bind="this.exportTable" png.bind="this.exportPng"/>
                        </header>
                        <t t-if="this.state.data">
                            <p class="o_ag_reports_dates text-muted">
                                <t t-out="this.state.data.sprint.date_start"/> to <t t-out="this.state.data.sprint.date_end"/>
                                <t t-if="this.state.data.sprint.goal"> · <t t-out="this.state.data.sprint.goal"/></t>
                            </p>
                            <p class="o_ag_reports_delivered" t-out="this.delivered"/>
                            <div t-if="!this.notStarted" class="o_ag_reports_bars" role="img" t-att-aria-label="this.delivered">
                                <div class="o_ag_reports_bar_row"><span>Planned</span>
                                    <i class="o_ag_reports_bar o_ag_reports_bar_planned" t-attf-style="width: {{this.barWidths.planned}}%"/>
                                    <span class="o_ag_reports_bar_points"><b t-out="this.state.data.delivered.planned_points"/> <t t-out="this.unitShort(this.state.data.estimate_unit)"/></span></div>
                                <div class="o_ag_reports_bar_row"><span>Delivered</span>
                                    <i class="o_ag_reports_bar o_ag_reports_bar_done" t-attf-style="width: {{this.barWidths.delivered}}%"/>
                                    <span class="o_ag_reports_bar_points"><b t-out="this.state.data.delivered.completed_points"/> <t t-out="this.unitShort(this.state.data.estimate_unit)"/></span></div>
                            </div>
                            <p t-if="this.state.data.no_plan" class="o_ag_reports_empty">This sprint has no plan history yet, so there is nothing to compare.</p>
                            <section t-if="this.state.data.previous_actions.actions.length" class="o_ag_reports_retro o_ag_reports_previous" aria-label="Open actions from the last retrospective">
                                <h3>Open actions from <t t-out="this.state.data.previous_actions.sprint.name"/></h3>
                                <ul class="o_ag_reports_actions">
                                    <li t-foreach="this.state.data.previous_actions.actions" t-as="item" t-key="item.id">
                                        <a href="#" t-on-click.prevent="() => this.openIssue(item)"><b t-out="item.key"/> <t t-out="item.name"/></a>
                                        <span class="text-muted" t-out="item.status"/>
                                    </li>
                                </ul>
                            </section>
                            <section t-if="this.state.data.sprint.state !== 'draft'" class="o_ag_reports_retro" aria-label="Retrospective notes">
                                <h3>Retrospective notes</h3>
                                <p t-if="this.state.data.sprint.retro_notes" class="o_ag_reports_retro_text" t-out="this.state.data.sprint.retro_notes"/>
                                <p t-else="" class="text-muted">No retrospective notes yet. A project manager can add them on the sprint.</p>
                                <h4>Actions</h4>
                                <ul t-if="this.state.data.retro_actions.length" class="o_ag_reports_actions">
                                    <li t-foreach="this.state.data.retro_actions" t-as="item" t-key="item.id">
                                        <a href="#" t-on-click.prevent="() => this.openIssue(item)"><b t-out="item.key"/> <t t-out="item.name"/></a>
                                        <span class="text-muted" t-out="item.status"/>
                                    </li>
                                </ul>
                                <p t-else="" class="text-muted">No actions yet.</p>
                                <form t-if="this.state.data.can_manage" class="o_ag_reports_action_form" t-on-submit="this.addRetroAction">
                                    <input type="text" class="form-control" placeholder="What will the team do?" aria-label="New retrospective action" t-model="this.agileModel(this.state, 'actionName')"/>
                                    <button type="submit" class="btn btn-secondary">Add action</button>
                                </form>
                            </section>
                            <div class="o_ag_reports_tiles">
                                <button t-foreach="this.tiles" t-as="tile" t-key="tile.code" type="button" class="o_ag_reports_tile"
                                        t-att-data-group="tile.code"
                                        t-att-aria-label="'Open the ' + this.state.data.groups[tile.code].count + ' issues: ' + tile.label"
                                        t-on-click="() => this.openGroup(tile.code)">
                                    <span class="o_ag_reports_tile_count" t-out="this.state.data.groups[tile.code].count"/>
                                    <span class="o_ag_reports_tile_label"
                                          t-out="(tile.code === 'carried' and this.state.data.so_far) ? tile.openLabel : tile.label"/>
                                    <span class="o_ag_reports_tile_points" t-out="this.groupText(tile.code)"/>
                                </button>
                            </div>
                            <section t-foreach="this.tiles" t-as="tile" t-key="tile.code" class="o_ag_reports_list" t-att-data-group="tile.code">
                                <h3 t-out="(tile.code === 'carried' and this.state.data.so_far) ? tile.openLabel : tile.label"/>
                                <p t-if="!this.state.data.groups[tile.code].issues.length" class="text-muted">
                                    <t t-if="this.state.data.groups[tile.code].hidden">None you can see.</t>
                                    <t t-else="">None.</t>
                                </p>
                                <table t-else="" class="table table-sm o_ag_reports_table">
                                    <thead><tr><th>Key</th><th>Title</th><th>Status</th><th class="text-end">Estimate</th><th t-att-aria-hidden="tile.code === 'carried' ? null : 'true'"><t t-if="tile.code === 'carried'">Now in</t></th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="this.state.data.groups[tile.code].issues" t-as="issue" t-key="issue.id">
                                            <td><a href="#" t-on-click.prevent="() => this.openIssue(issue)" t-out="issue.key"/></td>
                                            <td t-out="issue.name"/>
                                            <td t-out="issue.status"/>
                                            <td class="text-end" t-out="issue.points"/>
                                            <td t-att-aria-hidden="tile.code === 'carried' ? null : 'true'"><t t-if="tile.code === 'carried'" t-out="issue.where"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </section>
                        </t>
                    </t>
                </main>
            </div>
        </Layout>
    </t>
</templates>
