<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="agile_issue_migration_wizard_form" model="ir.ui.view">
        <field name="name">agile.community.issue.migration.wizard.form</field>
        <field name="model">agile_community.issue_migration_wizard</field>
        <field name="arch" type="xml">
            <form string="Prepare Existing Tasks for Agile">
                <div class="alert alert-info" role="status">
                    <p>Select existing tasks, choose a default issue type, and map every non-Agile stage. Task IDs and history remain in place. Key assignment and stage mapping are applied together; if validation fails, no selected task is converted.</p>
                    <p>
                        <field name="task_count" readonly="1" class="oe_inline"/> selected ·
                        <field name="missing_key_count" readonly="1" class="oe_inline"/> need keys ·
                        <field name="missing_type_count" readonly="1" class="oe_inline"/> need types ·
                        <field name="stages_to_map_count" readonly="1" class="oe_inline"/> legacy stages to map
                    </p>
                </div>
                <group>
                    <field name="project_id" readonly="1"/>
                    <field name="task_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="issue_type_id" options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
                <group string="Stage mapping" invisible="stages_to_map_count == 0">
                    <field name="stage_mapping_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="source_stage_id"/>
                            <field name="target_stage_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_convert" type="object" string="Preview and convert" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_agile_issue_migration_wizard" model="ir.actions.act_window">
        <field name="name">Prepare Agile conversion</field>
        <field name="res_model">agile_community.issue_migration_wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="agile_issue_migration_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_task_ids': [(6, 0, active_ids)]}</field>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>
</odoo>
