<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agile_project_member_list" model="ir.ui.view">
        <field name="name">agile.project.member.list</field>
        <field name="model">agile.project.member</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="1" edit="1" delete="1">
                <field name="project_id" column_invisible="1"/>
                <field name="user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="role"/>
                <field name="assigned_by_id" optional="hide" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_agile_project_member_form" model="ir.ui.view">
        <field name="name">agile.project.member.form</field>
        <field name="model">agile.project.member</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="project_id" readonly="1"/>
                        <field name="user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="role"/>
                        <field name="assigned_by_id" readonly="1"/>
                    </group>
                    <div class="alert alert-info" role="status">
                        Agile roles control this project's delivery actions. Native Odoo Project access is still required.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agile_project_member" model="ir.actions.act_window">
        <field name="name">Agile Team</field>
        <field name="res_model">agile.project.member</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_agile_project_member_list"/>
        <field name="context">{'default_project_id': active_id}</field>
    </record>
</odoo>
